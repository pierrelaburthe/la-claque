<!-- Les pastilles de variation sont injectées en JS : styles + keyframe en global
     (le nom d'animation d'un <style> scopé serait renommé et ne matcherait plus). -->
<style is:global>
  .game .gdelta { position: absolute; top: -4px; right: 0; font-family: var(--sans); font-size: 0.74rem; font-weight: 800; opacity: 0; pointer-events: none; }
  .game .gdelta.up { color: #2f7d4f; }
