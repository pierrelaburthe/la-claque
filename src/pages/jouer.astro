---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const abs = (p: string) => new URL(url(p), Astro.site).href;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Un mois au OFF',
    url: abs('/jouer'),
    genre: ['Jeu de décision', 'Gestion'],
    gamePlatform: 'Navigateur web',
    applicationCategory: 'Game',
    inLanguage: 'fr',
    author: { '@type': 'Organization', name: 'La Claque' },
    description:
      "Un jeu de cartes à la Reigns : vous dirigez une compagnie au Festival OFF d'Avignon et devez tenir tout le mois en gardant l'équilibre entre trésorerie, public, moral de la troupe et presse.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Un mois au OFF', item: abs('/jouer') },
    ],
  },
];
---
<Base
  title="Un mois au OFF, le jeu — La Claque"
  description="Dirigez une compagnie au Festival OFF d'Avignon dans ce jeu de cartes à la Reigns : chaque décision fait pencher votre trésorerie, votre public, le moral de la troupe et la presse. Tiendrez-vous tout le mois ?"
  active="jouer"
  jsonld={jsonld}
>
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › Le jeu</p>
    <div class="guide-head">
      <p class="kicker">Le jeu de La Claque</p>
      <h1>Un mois au OFF</h1>
      <p class="stand">Vous débarquez à Avignon avec votre compagnie et trois semaines devant vous. Chaque jour, une décision. Gardez la troupe à flot jusqu'à la dernière représentation, sans vider la caisse, vider la salle, épuiser les comédien·nes ni disparaître des radars de la presse.</p>
    </div>
  </div>

  <div class="wrap-narrow">
    <div class="game" id="game">
      <button class="sound-toggle" id="mute" type="button" aria-pressed="false" title="Activer ou couper le son">Son</button>
      <p class="daycount" id="daycount" hidden></p>
      <div class="gauges" id="gauges" aria-hidden="true"></div>

      <div class="stage">
        <div class="screen" id="screen">
          <!-- écran de départ -->
          <div class="panel intro" id="intro">
            <p class="day-badge">Prêt·e ?</p>
            <p class="intro-txt">Balayez la carte ou utilisez les deux boutons. Chaque choix a un prix. Quatre jauges à surveiller : <b>Trésorerie</b>, <b>Public</b>, <b>Moral</b>, <b>Presse</b>. Attention, chaque jour les <b>frais courent, la fatigue monte et la presse vous oublie</b> un peu, tout seuls : impossible de se reposer sur ses lauriers. Si une jauge se vide ou déborde, le rideau tombe.</p>
            <button class="btn play" id="start">Lever le rideau</button>
          </div>

          <!-- carte de jeu -->
          <article class="panel card" id="card" hidden>
            <div class="portrait" id="portrait"><span id="portraitGlyph">?</span></div>
            <p class="perso" id="perso"></p>
            <p class="ctext" id="ctext"></p>
            <div class="hint left" id="hintL"></div>
            <div class="hint right" id="hintR"></div>
          </article>

          <!-- fin de partie -->
          <div class="panel end" id="end" hidden>
            <div class="portrait endic" id="endIcon"></div>
            <p class="day-badge" id="endKicker"></p>
            <h2 id="endTitle"></h2>
            <p class="end-txt" id="endTxt"></p>
            <p class="end-score" id="endScore"></p>
            <button class="btn play" id="again">Rejouer</button>
          </div>
        </div>
      </div>

      <div class="choices" id="choices" hidden>
        <button class="choice cL" id="btnL"><span class="arr">←</span><span class="lab" id="labL"></span></button>
        <button class="choice cR" id="btnR"><span class="lab" id="labR"></span><span class="arr">→</span></button>
      </div>

      <p class="game-foot">Envie de vrais chiffres ? Passez au <a href={url('/guides/budget-festival-off-avignon')}>simulateur de budget</a>, ou lisez <a href={url('/guides/comment-se-faire-produire')}>comment se faire produire</a>.</p>
    </div>
  </div>
</Base>

<script>
  // ---- Les quatre jauges ----
  const GAUGES = [
    { key: 'treso', label: 'Trésorerie', bas: 'La caisse est vide. Vous remballez les décors avant la fin du mois.', haut: "Tant d'argent d'un coup que le fisc s'invite en coulisses. Contrôle fatal." },
    { key: 'public', label: 'Public', bas: 'Trois personnes dans la salle, dont votre mère. Le bouche à oreille vous a oublié·es.', haut: "Salle bondée jusque dans les escaliers : les pompiers ferment le théâtre pour surbooking." },
    { key: 'moral', label: 'Moral', bas: 'Épuisée et démoralisée, la troupe rend son tablier avant la fin.', haut: "L'euphorie tourne à la fête permanente : plus personne ne monte sur scène à l'heure." },
    { key: 'presse', label: 'Presse', bas: 'Aucun média ne parle de vous. Vous jouez dans l\'indifférence totale.', haut: 'Starisé·es trop vite, vous récoltez un retour de bâton médiatique qui vous enterre.' },
  ];
  const START = { treso: 40, public: 26, moral: 56, presse: 22 };
  const MAX_JOUR = 24;
  // Usure quotidienne : les frais courent, la fatigue s'accumule, et la presse
  // vous oublie un peu chaque jour si vous ne la nourrissez pas. On ne coaste jamais.
  const DRIFT = { treso: -3, moral: -2, presse: -1 };

  // ---- Le paquet de cartes ----
  const DECK = [
    { perso: 'La régie du théâtre', ic: 'maison', g: 'T', c: '#7a2018', t: "Le lieu vous propose un meilleur créneau, à 19 h, mais 300 € de plus pour le mois.",
      L: { lab: 'On prend le créneau', fx: { treso: -12, public: +14 } },
      R: { lab: 'On garde 14 h', fx: { treso: +4, public: -8 } } },
    { perso: 'Un programmateur', ic: 'programmateur', g: 'P', c: '#2d4a3e', t: "Il glisse qu'il passera peut-être ce soir. La troupe le sait et commence à trembler.",
      L: { lab: 'On soigne tout', fx: { moral: -10, presse: +16 } },
      R: { lab: 'On joue normal', fx: { moral: +6, presse: -6 } } },
    { perso: 'La canicule', ic: 'soleil', g: 'C', c: '#b5651d', t: "38 °C sur le tractage. Distribuer des flyers sous ce soleil, c'est un sport de combat.",
      L: { lab: 'On tracte quand même', fx: { public: +12, moral: -12 } },
      R: { lab: 'Pause à l\'ombre', fx: { public: -8, moral: +8 } } },
    { perso: 'Billetreduc', ic: 'avis', g: 'B', c: '#444', t: "Un spectateur laisse un avis tiède. Il traîne en haut de votre fiche.",
      L: { lab: 'On répond, courtois', fx: { presse: +6, moral: -6 } },
      R: { lab: 'On ignore', fx: { moral: +4, public: -6 } } },
    { perso: 'La compagnie d\'à côté', ic: 'public', g: 'D', c: '#5a3e7a', t: "Leur salle affiche complet chaque soir. La comparaison plombe le moral des troupes.",
      L: { lab: 'On va les voir', fx: { moral: +8, presse: +4, treso: -4 } },
      R: { lab: 'On se concentre', fx: { moral: -6, public: +8 } } },
    { perso: 'Un comédien enroué', ic: 'blessure', g: 'V', c: '#7a2018', t: "Sa voix lâche. Jouer ce soir, c'est risquer une extinction totale pour trois jours.",
      L: { lab: 'Il joue en force', fx: { public: +6, moral: -14 } },
      R: { lab: 'Doublure improvisée', fx: { public: -6, presse: -4, moral: +6 } } },
    { perso: 'Le mistral', ic: 'vent', g: 'M', c: '#2d4a3e', t: "Le vent arrache vos affiches dans toute la ville pendant la nuit.",
      L: { lab: 'On recolle partout', fx: { treso: -8, public: +10, moral: -6 } },
      R: { lab: 'Tant pis', fx: { public: -10 } } },
    { perso: 'Une attachée de presse', ic: 'presse', g: 'A', c: '#b5651d', t: "Elle propose de vous décrocher deux papiers. Son forfait : 600 € pour le festival.",
      L: { lab: 'On investit', fx: { treso: -16, presse: +20 } },
      R: { lab: 'On fait nous-mêmes', fx: { presse: -4, moral: -4 } } },
    { perso: 'La caisse du soir', ic: 'euro', g: 'E', c: '#444', t: "Salle à moitié pleine. Un groupe demande un tarif de dernière minute cassé.",
      L: { lab: 'On brade les places', fx: { treso: -6, public: +12 } },
      R: { lab: 'Plein tarif', fx: { treso: +8, public: -6 } } },
    { perso: 'Un after de festivaliers', ic: 'verre', g: 'F', c: '#5a3e7a', t: "La troupe est invitée à faire la fête jusqu'au bout de la nuit avec d'autres compagnies.",
      L: { lab: 'On y va', fx: { moral: +14, presse: +6, public: -4 } },
      R: { lab: 'Au lit', fx: { moral: -8, public: +6 } } },
    { perso: 'La Provence', ic: 'micro', g: 'J', c: '#7a2018', t: "Un journaliste veut une interview, mais demain à 8 h, en pleine grasse matinée méritée.",
      L: { lab: 'On se lève', fx: { moral: -10, presse: +16 } },
      R: { lab: 'On décline', fx: { moral: +6, presse: -10 } } },
    { perso: 'Le proprio du logement', ic: 'maison', g: 'L', c: '#2d4a3e', t: "Il augmente le loyer en cours de séjour. C'est Avignon, c'est comme ça, dit-il.",
      L: { lab: 'On paie', fx: { treso: -14, moral: +2 } },
      R: { lab: 'On négocie fort', fx: { treso: -4, moral: -8 } } },
    { perso: 'Le bouche à oreille', ic: 'bouche', g: 'O', c: '#b5651d', t: "Deux spectatrices conquises reviennent avec dix amis. La rumeur monte.",
      L: { lab: 'On les chouchoute', fx: { public: +14, treso: -4 } },
      R: { lab: 'On reste discret', fx: { public: +6, moral: +4 } } },
    { perso: 'Une panne technique', ic: 'projecteur', g: 'T', c: '#444', t: "Le projecteur principal grille dix minutes avant l'ouverture des portes.",
      L: { lab: 'Réparation express', fx: { treso: -10, public: +4 } },
      R: { lab: 'On joue sans', fx: { presse: -6, moral: -4, public: -4 } } },
    { perso: 'Un producteur intéressé', ic: 'programmateur', g: 'P', c: '#2d4a3e', t: "Il évoque une tournée l'an prochain, si le spectacle tient ses promesses ce mois-ci.",
      L: { lab: 'On lui promet tout', fx: { presse: +12, moral: -6 } },
      R: { lab: 'On reste prudent', fx: { presse: +4, moral: +6 } } },
    { perso: 'La fatigue', ic: 'fatigue', g: 'Z', c: '#5a3e7a', t: "Mi-parcours. Les corps tirent, les répliques flottent, la lassitude s'installe.",
      L: { lab: 'Journée de repos', fx: { public: -8, moral: +14, treso: -4 } },
      R: { lab: 'On serre les dents', fx: { moral: -10, public: +6 } } },
    { perso: 'Un critique influent', ic: 'plume', g: 'K', c: '#7a2018', t: "Une plume redoutée est dans la salle. Son papier peut vous lancer ou vous briser.",
      L: { lab: 'On donne tout', fx: { moral: -8, presse: +18, public: +4 } },
      R: { lab: 'On reste soi-même', fx: { presse: +6, moral: +4 } } },
    { perso: 'Le tractage', ic: 'tract', g: 'H', c: '#b5651d', t: "Vous pouvez tracter deux heures de plus sur la place de l'Horloge, bondée à midi.",
      L: { lab: 'On y retourne', fx: { public: +12, moral: -10 } },
      R: { lab: 'On économise nos forces', fx: { public: -4, moral: +8 } } },
    { perso: 'Les réseaux sociaux', ic: 'telephone', g: 'R', c: '#444', t: "Une vidéo des coulisses pourrait tourner, mais dévoile la meilleure scène du spectacle.",
      L: { lab: 'On la poste', fx: { presse: +12, public: +6, moral: -4 } },
      R: { lab: 'On garde le mystère', fx: { presse: -4, public: -2 } } },
    { perso: 'La coprod de dernière minute', ic: 'mains', g: 'S', c: '#2d4a3e', t: "Une compagnie amie propose d'échanger vos publics contre une part de recette.",
      L: { lab: 'On s\'allie', fx: { treso: +10, public: +8, presse: -2 } },
      R: { lab: 'On reste indépendant', fx: { moral: +6, public: -6 } } },
    { perso: 'Un rappel qui n\'en finit pas', ic: 'mains', g: 'W', c: '#5a3e7a', t: "Le public en redemande. Rester dix minutes de plus, c'est rater la navette du dernier bus.",
      L: { lab: 'On savoure le rappel', fx: { public: +10, moral: +8, treso: -6 } },
      R: { lab: 'On file', fx: { moral: -4 } } },
    { perso: 'L\'AF&C', ic: 'document', g: 'G', c: '#b5651d', t: "L'association du OFF propose de figurer dans une sélection thématique, moyennant un dossier à boucler ce soir.",
      L: { lab: 'On monte le dossier', fx: { moral: -6, presse: +12, public: +4 } },
      R: { lab: 'Trop tard, on dort', fx: { moral: +6, presse: -6 } } },
    { perso: 'Un mécène du coin', ic: 'cheque', g: 'N', c: '#2d4a3e', t: "Un notable avignonnais adore le spectacle et propose un chèque, en échange d'un remerciement appuyé qui gêne la troupe.",
      L: { lab: 'On accepte le chèque', fx: { treso: +20, moral: -6 } },
      R: { lab: 'On refuse poliment', fx: { moral: +6, treso: -2 } } },
    { perso: 'Un atelier rémunéré', ic: 'euro', g: 'X', c: '#444', t: "Une MJC propose à la troupe d'animer un stage en matinée. Bien payé, mais c'est autant d'énergie en moins pour le soir.",
      L: { lab: 'On prend le stage', fx: { treso: +14, moral: -8 } },
      R: { lab: 'On garde nos forces', fx: { moral: +4, treso: -3 } } },
    { perso: 'Une coquille sur l\'affiche', ic: 'tract', g: 'Q', c: '#7a2018', t: "L'imprimeur a écrit votre titre de travers sur 500 affiches déjà collées en ville.",
      L: { lab: 'On réimprime tout', fx: { treso: -12, presse: +4 } },
      R: { lab: 'On en rit sur les réseaux', fx: { presse: -6, public: +6, moral: +4 } } },
    { perso: 'Une nomination surprise', ic: 'trophee', g: 'Y', c: '#b5651d', t: "Votre spectacle est cité parmi les coups de cœur d'un site influent. Le téléphone s'emballe.",
      L: { lab: 'On surfe sur la vague', fx: { presse: +14, public: +10, moral: -6 } },
      R: { lab: 'On reste concentré', fx: { presse: +6, moral: +4 } } },
    { perso: 'Une entorse en coulisses', ic: 'blessure', g: 'I', c: '#5a3e7a', t: "Une comédienne se tord la cheville à l'échauffement. Jouer quand même, ou annuler la représentation ?",
      L: { lab: 'On adapte la mise en scène', fx: { moral: -6, public: -4 } },
      R: { lab: 'On annule ce soir', fx: { treso: -10, public: -8, moral: +4 } } },
    { perso: 'Une matinée idéale', ic: 'soleil', g: 'É', c: '#2d4a3e', t: "Ni trop chaud ni mistral : une journée parfaite pour tracter et remplir la salle.",
      L: { lab: 'On tracte à fond', fx: { public: +12, moral: +4, treso: -2 } },
      R: { lab: 'On répète plutôt', fx: { moral: +8, presse: +2 } } },
    { perso: 'Le collectif d\'entraide', ic: 'mains', g: 'U', c: '#444', t: "D'autres compagnies proposent de mutualiser logement et repas pour alléger la note de tout le monde.",
      L: { lab: 'On mutualise', fx: { treso: +12, moral: +6, presse: -2 } },
      R: { lab: 'On reste entre nous', fx: { moral: +2 } } },
    { perso: 'Un bug de billetterie', ic: 'billet', g: '#', c: '#7a2018', t: "La plateforme en ligne plante un week-end entier. Des spectateurs n'arrivent pas à réserver.",
      L: { lab: 'On vend en direct, à la caisse', fx: { treso: +4, moral: -6, public: +2 } },
      R: { lab: 'On attend que ça revienne', fx: { treso: -8, public: -6 } } },
    { perso: 'Une radio locale', ic: 'micro', g: '@', c: '#b5651d', t: "France Bleu propose un direct à l'heure de la sieste, en plein cœur de journée.",
      L: { lab: 'On y passe', fx: { presse: +12, public: +4, moral: -6 } },
      R: { lab: 'On préserve la troupe', fx: { moral: +6, presse: -6 } } },
    { perso: 'Un resto qui fait crédit', ic: 'assiette', g: '&', c: '#5a3e7a', t: "Le patron du bistrot d'en face vous laisse une ardoise jusqu'à la fin du mois. Tentant, mais la note grimpera.",
      L: { lab: 'On ouvre l\'ardoise', fx: { treso: +10, moral: +6, presse: -2 } },
      R: { lab: 'On serre le budget', fx: { treso: -2, moral: -4 } } },
    { perso: 'Un tract mal placé', ic: 'tract', g: '§', c: '#2d4a3e', t: "Votre équipe a tracté deux heures devant un spectacle concurrent. Ambiance tendue sur le trottoir.",
      L: { lab: 'On assume le culot', fx: { public: +10, presse: -4, moral: -2 } },
      R: { lab: 'On s\'excuse et on bouge', fx: { public: -4, moral: +4 } } },
    { perso: 'La demi-jauge du lundi', ic: 'public', g: '½', c: '#444', t: "Lundi creux, salle à moitié vide. Offrir des places aux étudiants pour faire du bruit, ou assumer la petite jauge ?",
      L: { lab: 'Places offertes aux étudiants', fx: { treso: -6, public: +12, presse: +2 } },
      R: { lab: 'On joue pour ceux qui sont là', fx: { moral: +6, public: -2 } } },
  ];

  // ---- Icônes graphiques maison : masses pleines + trait épais, pas d'emoji ----
  const F = 'fill="#fff" stroke="none"'; // raccourci pour les aplats blancs
  const ICONS = {
    masques: `<path d="M4 6c4-1.4 12-1.4 16 0 0 8.4-3.1 13.4-8 13.4S4 14.4 4 6Z"/><circle cx="9.3" cy="10.6" r="1.1" ${F}/><circle cx="14.7" cy="10.6" r="1.1" ${F}/><path d="M9 14.1c1.4 1.3 4.6 1.3 6 0"/>`,
    programmateur: `<circle cx="12" cy="7.8" r="3.4" ${F}/><path d="M5.3 20.2a6.7 6.7 0 0 1 13.4 0Z" ${F}/>`,
    soleil: `<circle cx="12" cy="12" r="4.4" ${F}/><path d="M12 2.6v2.5M12 18.9v2.5M2.6 12h2.5M18.9 12h2.5M5.1 5.1l1.7 1.7M17.2 17.2l1.7 1.7M18.9 5.1l-1.7 1.7M6.8 17.2l-1.7 1.7"/>`,
    avis: `<path d="M4 5h16v9.6H9.6L5.5 18v-3.4H4Z"/><path d="M12 7.2l1.06 2.15 2.37.34-1.72 1.67.41 2.36L12 12.97l-2.12 1.12.41-2.36-1.72-1.67 2.37-.34Z" ${F}/>`,
    public: `<circle cx="8" cy="9" r="2.6" ${F}/><circle cx="16" cy="9" r="2.6" ${F}/><path d="M3.5 18.2a4.5 4.5 0 0 1 9 0Z" ${F}/><path d="M11.5 18.2a4.5 4.5 0 0 1 9 0Z" ${F}/>`,
    blessure: `<circle cx="12" cy="12" r="8.6"/><path d="M10.6 7.1h2.8v3.5H17v2.8h-3.6v3.5h-2.8v-3.5H7v-2.8h3.6Z" ${F}/>`,
    vent: `<path d="M3 8h9.5a2.6 2.6 0 1 0-2.6-2.6"/><path d="M3 12h13.5a2.6 2.6 0 1 1-2.6 2.6"/><path d="M3 16h7.5"/>`,
    presse: `<rect x="3.5" y="5" width="17" height="14" rx="1.6"/><path d="M6.5 8.6h6M6.5 12h6M6.5 15.4h4"/><rect x="14.4" y="8.6" width="3.1" height="6.8" ${F}/>`,
    plume: `<path d="M20 4C11 5.5 6.5 11 5 20"/><path d="M20 4c-1.6 8-6.5 11.5-12.5 12.5"/><path d="M4.5 20h4"/>`,
    euro: `<circle cx="12" cy="12" r="8.6"/><path d="M15.6 9.1A3.9 3.9 0 0 0 9 12a3.9 3.9 0 0 0 6.6 2.9"/><path d="M7.4 11h5.6M7.4 13h4.6"/>`,
    verre: `<path d="M5 5h14l-7 7.6Z" ${F}/><path d="M12 12.6V19M8.5 19h7"/><path d="M14.6 7.4l3-2.4"/>`,
    micro: `<rect x="9.2" y="3" width="5.6" height="10" rx="2.8" ${F}/><path d="M6.2 11a5.8 5.8 0 0 0 11.6 0"/><path d="M12 16.8V20M9 20h6"/>`,
    projecteur: `<path d="M12 3a6 6 0 0 1 3.8 10.6c-.7.7-1.1 1.3-1.3 2H9.5c-.2-.7-.6-1.3-1.3-2A6 6 0 0 1 12 3Z" ${F}/><path d="M9.2 18.5h5.6M10.2 21h3.6"/>`,
    tract: `<rect x="6" y="4" width="12" height="16" rx="1.4"/><path d="M9 8h6M9 11h6M9 14h4"/>`,
    bouche: `<path d="M4 10v4l10 4.6V5.4Z" ${F}/><path d="M15 8.4a4 4 0 0 1 0 7.2"/><path d="M6.6 14.6V18h2.2"/>`,
    document: `<path d="M6.5 3h6.5l4.5 4.5V21h-11Z"/><path d="M13 3v4.5h4.5"/><path d="M9 13h6M9 16h6"/>`,
    cheque: `<rect x="3" y="7" width="18" height="10" rx="1.6"/><circle cx="12" cy="12" r="2.6" ${F}/><path d="M6 12h.4M17.6 12h.4"/>`,
    trophee: `<path d="M8 4h8v4.6a4 4 0 0 1-8 0Z" ${F}/><path d="M8 5H4.8v1.9a3.1 3.1 0 0 0 3.2 3.1M16 5h3.2v1.9a3.1 3.1 0 0 1-3.2 3.1"/><path d="M12 12.6v3.6M9.4 20h5.2M10.2 20l.5-4h2.6l.5 4"/>`,
    billet: `<path d="M4 8.5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4Z"/><path d="M14 7v10" stroke-dasharray="1.6 2.4"/>`,
    maison: `<path d="M4 11l8-6 8 6"/><path d="M6 10.4v8.6h12v-8.6"/><rect x="10.1" y="13" width="3.8" height="6" ${F}/>`,
    telephone: `<rect x="7" y="3" width="10" height="18" rx="2.3"/><path d="M10.4 18.3h3.2"/><path d="M12 7.4l.78 1.55 1.72.25-1.24 1.2.3 1.7L12 12.55l-1.56.8.3-1.7-1.24-1.2 1.72-.25Z" ${F}/>`,
    mains: `<path d="M8 12.5V6.2a1.5 1.5 0 0 1 3 0v5"/><path d="M11 11.2V5a1.5 1.5 0 0 1 3 0v6.2"/><path d="M14 11.2V7.2a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6c-2.6 0-3.8-1.3-5.6-3.8l-1.2-1.7a1.4 1.4 0 0 1 2.2-1.7L8 13.5"/>`,
    assiette: `<path d="M7 3v18"/><path d="M4.8 3v3.6a2.2 2.2 0 0 0 4.4 0V3"/><path d="M17 3c-1.8 0-2.9 2.3-2.9 5.2s1.1 4.3 2.9 4.3Z" ${F}/><path d="M17 12.5V21"/>`,
    fatigue: `<rect x="3" y="8.5" width="15" height="7" rx="1.6"/><path d="M20 11v2"/><rect x="5.4" y="10.2" width="3.2" height="3.6" ${F}/>`,
  };
  const svgFor = (card) => `<svg viewBox="0 0 24 24">${ICONS[card.ic] || ICONS.masques}</svg>`;

  // ---- État ----
  let g = { ...START };
  let jour = 1;
  let current = null;
  let bag = [];
  let lastCard = null;
  let busy = false;

  const $ = (id) => document.getElementById(id);
  const clamp = (n) => Math.max(0, Math.min(100, n));

  // ---- Son discret (Web Audio synthétisé, aucune ressource externe) ----
  let actx = null, muted = false;
  try { muted = localStorage.getItem('laclaque_mute') === '1'; } catch (e) {}
  function ac() { if (!actx) { try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} } return actx; }
  function tone(freq, dur, type, vol, when) {
    const c = ac(); if (!c || muted) return;
    const t = c.currentTime + (when || 0);
    const o = c.createOscillator(), gn = c.createGain();
    o.type = type; o.frequency.value = freq; o.connect(gn); gn.connect(c.destination);
    gn.gain.setValueAtTime(0.0001, t);
    gn.gain.exponentialRampToValueAtTime(vol, t + 0.012);
    gn.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.start(t); o.stop(t + dur + 0.03);
  }
  const sClick = () => tone(300, 0.09, 'triangle', 0.05, 0);
  const sWin = () => [523, 659, 784, 1047].forEach((f, i) => tone(f, 0.55, 'sine', 0.06, i * 0.11));
  const sLose = () => { tone(196, 0.5, 'sawtooth', 0.05, 0); tone(147, 0.7, 'sine', 0.05, 0.09); };
  function setMute(m) {
    muted = m;
    const btn = $('mute');
    btn.setAttribute('aria-pressed', String(m));
    btn.textContent = m ? 'Son coupé' : 'Son';
    btn.classList.toggle('off', m);
    try { localStorage.setItem('laclaque_mute', m ? '1' : '0'); } catch (e) {}
  }

  // Paquet mélangé : on voit toutes les cartes avant qu'une seule revienne. Vraie variété.
  function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function pick() {
    if (bag.length === 0) bag = shuffle([...DECK]);
    let c = bag.pop();
    if (c === lastCard && bag.length > 0) { bag.unshift(c); c = bag.pop(); }
    lastCard = c;
    return c;
  }

  function buildGauges() {
    $('gauges').innerHTML = GAUGES.map((G) =>
      `<div class="gauge" data-k="${G.key}"><span class="gl">${G.label}</span>` +
      `<span class="gbar"><span class="gfill"></span></span><span class="gdelta"></span></div>`
    ).join('');
    updateGauges(null);
  }
  function updateGauges(delta) {
    for (const G of GAUGES) {
      const el = $('gauges').querySelector(`.gauge[data-k="${G.key}"]`);
      if (!el) continue;
      const v = clamp(g[G.key]);
      el.querySelector('.gfill').style.width = v + '%';
      el.classList.toggle('danger', v <= 22 || v >= 78);
      const badge = el.querySelector('.gdelta');
      const d = delta && delta[G.key];
      if (d) {
        badge.textContent = (d > 0 ? '+' : '') + d;
        badge.className = 'gdelta ' + (d > 0 ? 'up' : 'down');
        badge.style.animation = 'none'; void badge.offsetWidth; badge.style.animation = '';
      } else {
        badge.textContent = '';
        badge.className = 'gdelta';
      }
    }
  }

  function updateDayCount() { $('daycount').textContent = `Représentation ${Math.min(jour, MAX_JOUR)} sur ${MAX_JOUR}`; }

  function showCard() {
    current = pick();
    $('portrait').style.background = current.c;
    $('portrait').innerHTML = svgFor(current);
    $('perso').textContent = current.perso;
    $('ctext').textContent = current.t;
    $('labL').textContent = current.L.lab;
    $('labR').textContent = current.R.lab;
    updateDayCount();
    $('daycount').hidden = false;
    $('card').hidden = false;
    $('choices').hidden = false;
    $('intro').hidden = true;
    $('end').hidden = true;
    busy = false;
    resetCardPos();
    // La pastille et le texte entrent en scène.
    const cardEl = $('card');
    cardEl.classList.remove('enter'); void cardEl.offsetWidth; cardEl.classList.add('enter');
  }

  function affected(fx) {
    return GAUGES.filter((G) => fx[G.key]).map((G) => G.label).join(', ');
  }

  function apply(side) {
    if (busy || !current) return;
    busy = true;
    sClick();
    const fx = current[side].fx;
    // Le choix, plus l'usure quotidienne (frais + fatigue + presse).
    const delta = {};
    for (const G of GAUGES) delta[G.key] = (fx[G.key] || 0) + (DRIFT[G.key] || 0);
    for (const k in g) g[k] = g[k] + delta[k];
    // mort si une jauge se vide ou déborde (avant clamp)
    let death = null, deathKey = null;
    for (const G of GAUGES) {
      if (g[G.key] <= 0) { death = G.bas; deathKey = G.key; break; }
      if (g[G.key] >= 100) { death = G.haut; deathKey = G.key; break; }
    }
    for (const k in g) g[k] = clamp(g[k]);
    updateGauges(delta);
    $('choices').hidden = true; // on laisse l'animation des jauges jouer
    if (death) { setTimeout(() => end(false, death, deathKey), 640); return; }
    jour++;
    if (jour > MAX_JOUR) { setTimeout(() => end(true), 640); return; }
    setTimeout(showCard, 360);
  }

  const OUTCOME_IC = { treso: 'euro', public: 'public', moral: 'fatigue', presse: 'presse' };
  function end(win, cause, deathKey) {
    $('card').hidden = true;
    $('choices').hidden = true;
    $('intro').hidden = true;
    const end = $('end');
    end.hidden = false;
    let icKey, icColor;
    if (win) {
      $('endKicker').textContent = 'Rideau final';
      const p = g.presse, pub = g.public;
      let titre, txt;
      if (p >= 68) { titre = 'Révélation du OFF'; txt = "Vous avez tenu le mois entier et la presse ne parle que de vous. Un producteur vous embarque en tournée : le pari est gagné."; icKey = 'trophee'; icColor = '#b5651d'; }
      else if (p >= 42 || pub >= 60) { titre = 'Le mois est sauvé'; txt = "Vous êtes allé·es au bout, avec quelques belles salles et deux ou trois dates décrochées pour la suite. Honorable, et déjà beaucoup."; icKey = 'masques'; icColor = '#2d4a3e'; }
      else { titre = 'Vous avez survécu'; txt = "Trois semaines de théâtre, la troupe debout et la caisse à l'équilibre. Personne ne vous a repéré·es, mais vous êtes encore là. À refaire."; icKey = 'mains'; icColor = '#5a3e7a'; }
      $('endTitle').textContent = titre;
      $('endTxt').textContent = txt;
      $('endScore').innerHTML = `Trésorerie <b>${g.treso}</b> · Public <b>${g.public}</b> · Moral <b>${g.moral}</b> · Presse <b>${g.presse}</b>`;
    } else {
      $('endKicker').textContent = `Jour ${jour} sur ${MAX_JOUR}`;
      $('endTitle').textContent = 'Le rideau tombe trop tôt';
      $('endTxt').textContent = cause;
      $('endScore').innerHTML = `Vous avez tenu <b>${jour - 1}</b> représentation${jour - 1 > 1 ? 's' : ''}.`;
      icKey = OUTCOME_IC[deathKey] || 'masques'; icColor = '#7a2018';
    }
    const ei = $('endIcon');
    ei.style.background = icColor;
    ei.innerHTML = `<svg viewBox="0 0 24 24">${ICONS[icKey]}</svg>`;
    ei.classList.remove('pop'); void ei.offsetWidth; ei.classList.add('pop');
    if (win) sWin(); else sLose();
  }

  function reset() {
    g = { ...START };
    jour = 1;
    bag = [];
    lastCard = null;
    busy = false;
    buildGauges();
    showCard();
  }

  // ---- Interaction : boutons ----
  $('start').addEventListener('click', () => { ac(); reset(); });
  $('again').addEventListener('click', () => { ac(); reset(); });
  $('mute').addEventListener('click', () => { ac(); setMute(!muted); if (!muted) sClick(); });
  setMute(muted);
  $('btnL').addEventListener('click', () => apply('L'));
  $('btnR').addEventListener('click', () => apply('R'));
  $('btnL').addEventListener('mouseenter', () => showHint('L'));
  $('btnR').addEventListener('mouseenter', () => showHint('R'));
  $('btnL').addEventListener('mouseleave', hideHints);
  $('btnR').addEventListener('mouseleave', hideHints);

  function showHint(side) {
    if (!current) return;
    const el = side === 'L' ? $('hintL') : $('hintR');
    el.textContent = 'Influence : ' + affected(current[side].fx);
    el.style.opacity = '1';
  }
  function hideHints() { $('hintL').style.opacity = '0'; $('hintR').style.opacity = '0'; }

  // ---- Interaction : glisser la carte ----
  const card = $('card');
  let dragging = false, startX = 0, dx = 0;
  function resetCardPos() { card.style.transition = 'transform .25s ease'; card.style.transform = ''; hideHints(); }
  card.addEventListener('pointerdown', (e) => { dragging = true; startX = e.clientX; card.style.transition = 'none'; card.setPointerCapture(e.pointerId); });
  card.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    dx = e.clientX - startX;
    card.style.transform = `translateX(${dx}px) rotate(${dx / 22}deg)`;
    if (dx < -24) showHint('L'); else if (dx > 24) showHint('R'); else hideHints();
  });
  card.addEventListener('pointerup', () => {
    if (!dragging) return; dragging = false;
    if (dx < -80) { card.style.transition = 'transform .2s ease'; card.style.transform = 'translateX(-140%) rotate(-16deg)'; setTimeout(() => apply('L'), 150); }
    else if (dx > 80) { card.style.transition = 'transform .2s ease'; card.style.transform = 'translateX(140%) rotate(16deg)'; setTimeout(() => apply('R'), 150); }
    else resetCardPos();
    dx = 0;
  });

  // ---- Clavier ----
  document.addEventListener('keydown', (e) => {
    if ($('choices').hidden) return;
    if (e.key === 'ArrowLeft') apply('L');
    if (e.key === 'ArrowRight') apply('R');
  });

  buildGauges();
</script>

<style>
  .game { margin: 8px 0 20px; position: relative; padding-top: 30px; }
  /* .panel/.choices posent display:flex|grid, ce qui écrase [hidden]. On rétablit. */
  .game [hidden] { display: none !important; }
  .daycount { font-family: var(--sans); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.13em; color: var(--ink-3); text-align: center; margin: 0 0 14px; }
  .gauges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  /* .gauge est injecté en JS : selecteurs :global sinon le scope Astro ne l'atteint pas. */
  .gauges :global(.gauge) { text-align: center; position: relative; }
  .gauges :global(.gl) { display: block; font-family: var(--sans); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); margin-bottom: 6px; }
  .gauges :global(.gbar) { display: block; height: 10px; background: rgba(0,0,0,0.12); border-radius: 999px; overflow: hidden; }
  .gauges :global(.gfill) { display: block; height: 100%; background: var(--ink); border-radius: 999px; transition: width .3s ease, background .3s ease; }
  .gauges :global(.gauge.danger .gl) { color: var(--red); }
  .gauges :global(.gauge.danger .gfill) { background: var(--red); }

  .stage { position: relative; }
  .screen { position: relative; min-height: 380px; display: flex; align-items: stretch; }
  .panel { flex: 1; border: 1px solid var(--rule-2); background: var(--card); padding: 30px 26px; display: flex; flex-direction: column; align-items: center; text-align: center; justify-content: center; }

  .intro-txt, .end-txt { font-family: var(--serif); font-size: 1.05rem; line-height: 1.55; color: var(--ink-2); max-width: 46ch; margin: 10px 0 20px; }
  .day-badge { font-family: var(--sans); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--red); margin: 0 0 6px; }

  .card { cursor: grab; touch-action: pan-y; user-select: none; }
  .card:active { cursor: grabbing; }
  .portrait { width: 98px; height: 98px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 16px; box-shadow: 0 10px 26px rgba(0,0,0,0.24), inset 0 0 0 3px rgba(255,255,255,0.32), inset 0 0 0 4px rgba(0,0,0,0.06); }
  /* le SVG est injecté en JS : :global sinon le scope Astro ne l'atteint pas. */
  .portrait :global(svg) { width: 52px; height: 52px; fill: none; stroke: #fff; stroke-width: 2.3; stroke-linecap: round; stroke-linejoin: round; }

  /* Entrée en scène de la pastille et du texte à chaque nouvelle carte. */
  .card.enter .portrait { animation: popIn 0.5s cubic-bezier(.2,1.3,.45,1) both; }
  .card.enter .perso { animation: fadeUp 0.5s ease 0.08s both; }
  .card.enter .ctext { animation: fadeUp 0.55s ease 0.16s both; }
  .portrait.pop { animation: popIn 0.55s cubic-bezier(.2,1.3,.45,1) both; }
  @keyframes popIn { 0% { transform: scale(.4) rotate(-10deg); opacity: 0; } 55% { opacity: 1; } 100% { transform: scale(1) rotate(0); opacity: 1; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .card.enter .portrait, .card.enter .perso, .card.enter .ctext, .portrait.pop { animation: none; }
  }

  /* Bouton son */
  .sound-toggle { position: absolute; top: 0; right: 0; font-family: var(--sans); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); background: var(--paper); border: 1px solid var(--rule-2); border-radius: 999px; padding: 5px 12px 5px 23px; cursor: pointer; transition: all 0.12s ease; z-index: 2; }
  .sound-toggle::before { content: ''; position: absolute; left: 11px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--red); }
  .sound-toggle.off::before { background: var(--ink-3); }
  .sound-toggle:hover { border-color: var(--ink-3); color: var(--ink); }
  .perso { font-family: var(--sans); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin: 0 0 12px; }
  .ctext { font-family: var(--display); font-weight: 500; font-size: 1.5rem; line-height: 1.28; color: var(--ink); max-width: 24ch; margin: 0; letter-spacing: -0.01em; }
  .hint { position: absolute; top: 14px; font-family: var(--sans); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); opacity: 0; transition: opacity .15s; max-width: 40%; }
  .hint.left { left: 16px; text-align: left; }
  .hint.right { right: 16px; text-align: right; }

  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .choice { display: flex; align-items: center; gap: 10px; justify-content: center; padding: 16px 18px; border: 1px solid var(--ink); background: var(--paper); font-family: var(--serif); font-size: 1.02rem; color: var(--ink); cursor: pointer; transition: all .12s ease; min-height: 58px; }
  .choice:hover { background: var(--ink); color: var(--paper); }
  .choice .arr { font-family: var(--sans); font-weight: 700; font-size: 1.1rem; opacity: 0.6; }
  .cL { text-align: left; } .cR { text-align: right; }

  .btn.play { font-family: var(--sans); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; background: var(--red); color: #fff; border: 0; padding: 13px 26px; border-radius: 2px; cursor: pointer; }
  .btn.play:hover { filter: brightness(1.08); }
  .end h2 { font-family: var(--display); font-size: 2rem; margin: 0 0 10px; }
  .end-score { font-family: var(--sans); font-size: 0.82rem; color: var(--ink-3); margin: 0 0 22px; }
  .end-score b { color: var(--ink); }
  .game-foot { font-family: var(--sans); font-size: 0.82rem; color: var(--ink-3); text-align: center; margin-top: 22px; }

  @media (max-width: 520px) {
    .gauges :global(.gl) { font-size: 0.52rem; }
    .ctext { font-size: 1.28rem; }
    .choice { font-size: 0.92rem; padding: 14px 12px; }
  }
</style>

<!-- Les pastilles de variation sont injectées en JS : styles + keyframe en global
     (le nom d'animation d'un <style> scopé serait renommé et ne matcherait plus). -->
<style is:global>
  .game .gdelta { position: absolute; top: -4px; right: 0; font-family: var(--sans); font-size: 0.74rem; font-weight: 800; opacity: 0; pointer-events: none; }
  .game .gdelta.up { color: #2f7d4f; }
  .game .gdelta.down { color: #c0392b; }
  .game .gdelta.up, .game .gdelta.down { animation: laclaqueFloatDelta 0.95s ease-out; }
  @keyframes laclaqueFloatDelta {
    0% { opacity: 0; transform: translateY(8px); }
    18% { opacity: 1; }
    70% { opacity: 1; transform: translateY(-8px); }
    100% { opacity: 0; transform: translateY(-18px); }
  }
</style>
