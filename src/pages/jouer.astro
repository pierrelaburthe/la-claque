---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const abs = (p: string) => new URL(url(p), Astro.site).href;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Un mois au OFF',
    url: abs('/jouer'),
    genre: ['Jeu de décision', 'Gestion'],
    gamePlatform: 'Navigateur web',
    applicationCategory: 'Game',
    inLanguage: 'fr',
    author: { '@type': 'Organization', name: 'La Claque' },
    description:
      "Un jeu de cartes à la Reigns : vous dirigez une compagnie au Festival OFF d'Avignon et devez tenir tout le mois en gardant l'équilibre entre trésorerie, public, moral de la troupe et presse.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Un mois au OFF', item: abs('/jouer') },
    ],
  },
];
---
<Base
  title="Un mois au OFF, le jeu — La Claque"
  description="Dirigez une compagnie au Festival OFF d'Avignon dans ce jeu de cartes à la Reigns : chaque décision fait pencher votre trésorerie, votre public, le moral de la troupe et la presse. Tiendrez-vous tout le mois ?"
  active="jouer"
  jsonld={jsonld}
>
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › Le jeu</p>
    <div class="guide-head">
      <p class="kicker">Le jeu de La Claque</p>
      <h1>Un mois au OFF</h1>
      <p class="stand">Vous débarquez à Avignon avec votre compagnie et trois semaines devant vous. Chaque jour, une décision. Gardez la troupe à flot jusqu'à la dernière représentation, sans vider la caisse, vider la salle, épuiser les comédien·nes ni disparaître des radars de la presse.</p>
    </div>
  </div>

  <div class="wrap-narrow">
    <div class="game" id="game">
      <p class="daycount" id="daycount" hidden></p>
      <div class="gauges" id="gauges" aria-hidden="true"></div>

      <div class="stage">
        <div class="screen" id="screen">
          <!-- écran de départ -->
          <div class="panel intro" id="intro">
            <p class="day-badge">Prêt·e ?</p>
            <p class="intro-txt">Balayez la carte ou utilisez les deux boutons. Chaque choix a un prix. Quatre jauges à surveiller : <b>Trésorerie</b>, <b>Public</b>, <b>Moral</b>, <b>Presse</b>. Attention, chaque jour les <b>frais courent et la fatigue monte</b> tout seuls : impossible de se reposer sur ses lauriers. Si une jauge se vide ou déborde, le rideau tombe.</p>
            <button class="btn play" id="start">Lever le rideau</button>
          </div>

          <!-- carte de jeu -->
          <article class="panel card" id="card" hidden>
            <div class="portrait" id="portrait"><span id="portraitGlyph">?</span></div>
            <p class="perso" id="perso"></p>
            <p class="ctext" id="ctext"></p>
            <div class="hint left" id="hintL"></div>
            <div class="hint right" id="hintR"></div>
          </article>

          <!-- fin de partie -->
          <div class="panel end" id="end" hidden>
            <p class="day-badge" id="endKicker"></p>
            <h2 id="endTitle"></h2>
            <p class="end-txt" id="endTxt"></p>
            <p class="end-score" id="endScore"></p>
            <button class="btn play" id="again">Rejouer</button>
          </div>
        </div>
      </div>

      <div class="choices" id="choices" hidden>
        <button class="choice cL" id="btnL"><span class="arr">←</span><span class="lab" id="labL"></span></button>
        <button class="choice cR" id="btnR"><span class="lab" id="labR"></span><span class="arr">→</span></button>
      </div>

      <p class="game-foot">Envie de vrais chiffres ? Passez au <a href={url('/guides/budget-festival-off-avignon')}>simulateur de budget</a>, ou lisez <a href={url('/guides/comment-se-faire-produire')}>comment se faire produire</a>.</p>
    </div>
  </div>
</Base>

<script>
  // ---- Les quatre jauges ----
  const GAUGES = [
    { key: 'treso', label: 'Trésorerie', bas: 'La caisse est vide. Vous remballez les décors avant la fin du mois.', haut: "Tant d'argent d'un coup que le fisc s'invite en coulisses. Contrôle fatal." },
    { key: 'public', label: 'Public', bas: 'Trois personnes dans la salle, dont votre mère. Le bouche à oreille vous a oublié·es.', haut: "Salle bondée jusque dans les escaliers : les pompiers ferment le théâtre pour surbooking." },
    { key: 'moral', label: 'Moral', bas: 'Épuisée et démoralisée, la troupe rend son tablier avant la fin.', haut: "L'euphorie tourne à la fête permanente : plus personne ne monte sur scène à l'heure." },
    { key: 'presse', label: 'Presse', bas: 'Aucun média ne parle de vous. Vous jouez dans l\'indifférence totale.', haut: 'Starisé·es trop vite, vous récoltez un retour de bâton médiatique qui vous enterre.' },
  ];
  const START = { treso: 42, public: 28, moral: 60, presse: 20 };
  const MAX_JOUR = 24;
  // Usure quotidienne : les frais courent, la fatigue s'accumule. Impossible de coasting.
  const DRIFT = { treso: -3, moral: -2 };

  // ---- Le paquet de cartes ----
  const DECK = [
    { perso: 'La régie du théâtre', g: 'T', c: '#7a2018', t: "Le lieu vous propose un meilleur créneau, à 19 h, mais 300 € de plus pour le mois.",
      L: { lab: 'On prend le créneau', fx: { treso: -12, public: +14 } },
      R: { lab: 'On garde 14 h', fx: { treso: +4, public: -8 } } },
    { perso: 'Un programmateur', g: 'P', c: '#2d4a3e', t: "Il glisse qu'il passera peut-être ce soir. La troupe le sait et commence à trembler.",
      L: { lab: 'On soigne tout', fx: { moral: -10, presse: +16 } },
      R: { lab: 'On joue normal', fx: { moral: +6, presse: -6 } } },
    { perso: 'La canicule', g: 'C', c: '#b5651d', t: "38 °C sur le tractage. Distribuer des flyers sous ce soleil, c'est un sport de combat.",
      L: { lab: 'On tracte quand même', fx: { public: +12, moral: -12 } },
      R: { lab: 'Pause à l\'ombre', fx: { public: -8, moral: +8 } } },
    { perso: 'Billetreduc', g: 'B', c: '#444', t: "Un spectateur laisse un avis tiède. Il traîne en haut de votre fiche.",
      L: { lab: 'On répond, courtois', fx: { presse: +6, moral: -6 } },
      R: { lab: 'On ignore', fx: { moral: +4, public: -6 } } },
    { perso: 'La compagnie d\'à côté', g: 'D', c: '#5a3e7a', t: "Leur salle affiche complet chaque soir. La comparaison plombe le moral des troupes.",
      L: { lab: 'On va les voir', fx: { moral: +8, presse: +4, treso: -4 } },
      R: { lab: 'On se concentre', fx: { moral: -6, public: +8 } } },
    { perso: 'Un comédien enroué', g: 'V', c: '#7a2018', t: "Sa voix lâche. Jouer ce soir, c'est risquer une extinction totale pour trois jours.",
      L: { lab: 'Il joue en force', fx: { public: +6, moral: -14 } },
      R: { lab: 'Doublure improvisée', fx: { public: -6, presse: -4, moral: +6 } } },
    { perso: 'Le mistral', g: 'M', c: '#2d4a3e', t: "Le vent arrache vos affiches dans toute la ville pendant la nuit.",
      L: { lab: 'On recolle partout', fx: { treso: -8, public: +10, moral: -6 } },
      R: { lab: 'Tant pis', fx: { public: -10 } } },
    { perso: 'Une attachée de presse', g: 'A', c: '#b5651d', t: "Elle propose de vous décrocher deux papiers. Son forfait : 600 € pour le festival.",
      L: { lab: 'On investit', fx: { treso: -16, presse: +20 } },
      R: { lab: 'On fait nous-mêmes', fx: { presse: -4, moral: -4 } } },
    { perso: 'La caisse du soir', g: 'E', c: '#444', t: "Salle à moitié pleine. Un groupe demande un tarif de dernière minute cassé.",
      L: { lab: 'On brade les places', fx: { treso: -6, public: +12 } },
      R: { lab: 'Plein tarif', fx: { treso: +8, public: -6 } } },
    { perso: 'Un after de festivaliers', g: 'F', c: '#5a3e7a', t: "La troupe est invitée à faire la fête jusqu'au bout de la nuit avec d'autres compagnies.",
      L: { lab: 'On y va', fx: { moral: +14, presse: +6, public: -4 } },
      R: { lab: 'Au lit', fx: { moral: -8, public: +6 } } },
    { perso: 'La Provence', g: 'J', c: '#7a2018', t: "Un journaliste veut une interview, mais demain à 8 h, en pleine grasse matinée méritée.",
      L: { lab: 'On se lève', fx: { moral: -10, presse: +16 } },
      R: { lab: 'On décline', fx: { moral: +6, presse: -10 } } },
    { perso: 'Le proprio du logement', g: 'L', c: '#2d4a3e', t: "Il augmente le loyer en cours de séjour. C'est Avignon, c'est comme ça, dit-il.",
      L: { lab: 'On paie', fx: { treso: -14, moral: +2 } },
      R: { lab: 'On négocie fort', fx: { treso: -4, moral: -8 } } },
    { perso: 'Le bouche à oreille', g: 'O', c: '#b5651d', t: "Deux spectatrices conquises reviennent avec dix amis. La rumeur monte.",
      L: { lab: 'On les chouchoute', fx: { public: +14, treso: -4 } },
      R: { lab: 'On reste discret', fx: { public: +6, moral: +4 } } },
    { perso: 'Une panne technique', g: 'T', c: '#444', t: "Le projecteur principal grille dix minutes avant l'ouverture des portes.",
      L: { lab: 'Réparation express', fx: { treso: -10, public: +4 } },
      R: { lab: 'On joue sans', fx: { presse: -6, moral: -4, public: -4 } } },
    { perso: 'Un producteur intéressé', g: 'P', c: '#2d4a3e', t: "Il évoque une tournée l'an prochain, si le spectacle tient ses promesses ce mois-ci.",
      L: { lab: 'On lui promet tout', fx: { presse: +12, moral: -6 } },
      R: { lab: 'On reste prudent', fx: { presse: +4, moral: +6 } } },
    { perso: 'La fatigue', g: 'Z', c: '#5a3e7a', t: "Mi-parcours. Les corps tirent, les répliques flottent, la lassitude s'installe.",
      L: { lab: 'Journée de repos', fx: { public: -8, moral: +14, treso: -4 } },
      R: { lab: 'On serre les dents', fx: { moral: -10, public: +6 } } },
    { perso: 'Un critique influent', g: 'K', c: '#7a2018', t: "Une plume redoutée est dans la salle. Son papier peut vous lancer ou vous briser.",
      L: { lab: 'On donne tout', fx: { moral: -8, presse: +18, public: +4 } },
      R: { lab: 'On reste soi-même', fx: { presse: +6, moral: +4 } } },
    { perso: 'Le tractage', g: 'H', c: '#b5651d', t: "Vous pouvez tracter deux heures de plus sur la place de l'Horloge, bondée à midi.",
      L: { lab: 'On y retourne', fx: { public: +12, moral: -10 } },
      R: { lab: 'On économise nos forces', fx: { public: -4, moral: +8 } } },
    { perso: 'Les réseaux sociaux', g: 'R', c: '#444', t: "Une vidéo des coulisses pourrait tourner, mais dévoile la meilleure scène du spectacle.",
      L: { lab: 'On la poste', fx: { presse: +12, public: +6, moral: -4 } },
      R: { lab: 'On garde le mystère', fx: { presse: -4, public: -2 } } },
    { perso: 'La coprod de dernière minute', g: 'S', c: '#2d4a3e', t: "Une compagnie amie propose d'échanger vos publics contre une part de recette.",
      L: { lab: 'On s\'allie', fx: { treso: +10, public: +8, presse: -2 } },
      R: { lab: 'On reste indépendant', fx: { moral: +6, public: -6 } } },
    { perso: 'Un rappel qui n\'en finit pas', g: 'W', c: '#5a3e7a', t: "Le public en redemande. Rester dix minutes de plus, c'est rater la navette du dernier bus.",
      L: { lab: 'On savoure le rappel', fx: { public: +10, moral: +8, treso: -6 } },
      R: { lab: 'On file', fx: { moral: -4 } } },
    { perso: 'L\'AF&C', g: 'G', c: '#b5651d', t: "L'association du OFF propose de figurer dans une sélection thématique, moyennant un dossier à boucler ce soir.",
      L: { lab: 'On monte le dossier', fx: { moral: -6, presse: +12, public: +4 } },
      R: { lab: 'Trop tard, on dort', fx: { moral: +6, presse: -6 } } },
    { perso: 'Un mécène du coin', g: 'N', c: '#2d4a3e', t: "Un notable avignonnais adore le spectacle et propose un chèque, en échange d'un remerciement appuyé qui gêne la troupe.",
      L: { lab: 'On accepte le chèque', fx: { treso: +20, moral: -6 } },
      R: { lab: 'On refuse poliment', fx: { moral: +6, treso: -2 } } },
    { perso: 'Un atelier rémunéré', g: 'X', c: '#444', t: "Une MJC propose à la troupe d'animer un stage en matinée. Bien payé, mais c'est autant d'énergie en moins pour le soir.",
      L: { lab: 'On prend le stage', fx: { treso: +14, moral: -8 } },
      R: { lab: 'On garde nos forces', fx: { moral: +4, treso: -3 } } },
    { perso: 'Une coquille sur l\'affiche', g: 'Q', c: '#7a2018', t: "L'imprimeur a écrit votre titre de travers sur 500 affiches déjà collées en ville.",
      L: { lab: 'On réimprime tout', fx: { treso: -12, presse: +4 } },
      R: { lab: 'On en rit sur les réseaux', fx: { presse: -6, public: +6, moral: +4 } } },
    { perso: 'Une nomination surprise', g: 'Y', c: '#b5651d', t: "Votre spectacle est cité parmi les coups de cœur d'un site influent. Le téléphone s'emballe.",
      L: { lab: 'On surfe sur la vague', fx: { presse: +14, public: +10, moral: -6 } },
      R: { lab: 'On reste concentré', fx: { presse: +6, moral: +4 } } },
    { perso: 'Une entorse en coulisses', g: 'I', c: '#5a3e7a', t: "Une comédienne se tord la cheville à l'échauffement. Jouer quand même, ou annuler la représentation ?",
      L: { lab: 'On adapte la mise en scène', fx: { moral: -6, public: -4 } },
      R: { lab: 'On annule ce soir', fx: { treso: -10, public: -8, moral: +4 } } },
    { perso: 'Une matinée idéale', g: 'É', c: '#2d4a3e', t: "Ni trop chaud ni mistral : une journée parfaite pour tracter et remplir la salle.",
      L: { lab: 'On tracte à fond', fx: { public: +12, moral: +4, treso: -2 } },
      R: { lab: 'On répète plutôt', fx: { moral: +8, presse: +2 } } },
    { perso: 'Le collectif d\'entraide', g: 'U', c: '#444', t: "D'autres compagnies proposent de mutualiser logement et repas pour alléger la note de tout le monde.",
      L: { lab: 'On mutualise', fx: { treso: +12, moral: +6, presse: -2 } },
      R: { lab: 'On reste entre nous', fx: { moral: +2 } } },
    { perso: 'Un bug de billetterie', g: '#', c: '#7a2018', t: "La plateforme en ligne plante un week-end entier. Des spectateurs n'arrivent pas à réserver.",
      L: { lab: 'On vend en direct, à la caisse', fx: { treso: +4, moral: -6, public: +2 } },
      R: { lab: 'On attend que ça revienne', fx: { treso: -8, public: -6 } } },
    { perso: 'Une radio locale', g: '@', c: '#b5651d', t: "France Bleu propose un direct à l'heure de la sieste, en plein cœur de journée.",
      L: { lab: 'On y passe', fx: { presse: +12, public: +4, moral: -6 } },
      R: { lab: 'On préserve la troupe', fx: { moral: +6, presse: -6 } } },
    { perso: 'Un resto qui fait crédit', g: '&', c: '#5a3e7a', t: "Le patron du bistrot d'en face vous laisse une ardoise jusqu'à la fin du mois. Tentant, mais la note grimpera.",
      L: { lab: 'On ouvre l\'ardoise', fx: { treso: +10, moral: +6, presse: -2 } },
      R: { lab: 'On serre le budget', fx: { treso: -2, moral: -4 } } },
    { perso: 'Un tract mal placé', g: '§', c: '#2d4a3e', t: "Votre équipe a tracté deux heures devant un spectacle concurrent. Ambiance tendue sur le trottoir.",
      L: { lab: 'On assume le culot', fx: { public: +10, presse: -4, moral: -2 } },
      R: { lab: 'On s\'excuse et on bouge', fx: { public: -4, moral: +4 } } },
    { perso: 'La demi-jauge du lundi', g: '½', c: '#444', t: "Lundi creux, salle à moitié vide. Offrir des places aux étudiants pour faire du bruit, ou assumer la petite jauge ?",
      L: { lab: 'Places offertes aux étudiants', fx: { treso: -6, public: +12, presse: +2 } },
      R: { lab: 'On joue pour ceux qui sont là', fx: { moral: +6, public: -2 } } },
  ];

  // ---- État ----
  let g = { ...START };
  let jour = 1;
  let current = null;
  let bag = [];
  let lastCard = null;
  let busy = false;

  const $ = (id) => document.getElementById(id);
  const clamp = (n) => Math.max(0, Math.min(100, n));

  // Paquet mélangé : on voit toutes les cartes avant qu'une seule revienne. Vraie variété.
  function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function pick() {
    if (bag.length === 0) bag = shuffle([...DECK]);
    let c = bag.pop();
    if (c === lastCard && bag.length > 0) { bag.unshift(c); c = bag.pop(); }
    lastCard = c;
    return c;
  }

  function buildGauges() {
    $('gauges').innerHTML = GAUGES.map((G) =>
      `<div class="gauge" data-k="${G.key}"><span class="gl">${G.label}</span>` +
      `<span class="gbar"><span class="gfill"></span></span><span class="gdelta"></span></div>`
    ).join('');
    updateGauges(null);
  }
  function updateGauges(delta) {
    for (const G of GAUGES) {
      const el = $('gauges').querySelector(`.gauge[data-k="${G.key}"]`);
      if (!el) continue;
      const v = clamp(g[G.key]);
      el.querySelector('.gfill').style.width = v + '%';
      el.classList.toggle('danger', v <= 22 || v >= 78);
      const badge = el.querySelector('.gdelta');
      const d = delta && delta[G.key];
      if (d) {
        badge.textContent = (d > 0 ? '+' : '') + d;
        badge.className = 'gdelta ' + (d > 0 ? 'up' : 'down');
        badge.style.animation = 'none'; void badge.offsetWidth; badge.style.animation = '';
      } else {
        badge.textContent = '';
        badge.className = 'gdelta';
      }
    }
  }

  function updateDayCount() { $('daycount').textContent = `Représentation ${Math.min(jour, MAX_JOUR)} sur ${MAX_JOUR}`; }

  function showCard() {
    current = pick();
    $('portrait').style.background = current.c;
    $('portraitGlyph').textContent = current.g;
    $('perso').textContent = current.perso;
    $('ctext').textContent = current.t;
    $('labL').textContent = current.L.lab;
    $('labR').textContent = current.R.lab;
    updateDayCount();
    $('daycount').hidden = false;
    $('card').hidden = false;
    $('choices').hidden = false;
    $('intro').hidden = true;
    $('end').hidden = true;
    busy = false;
    resetCardPos();
  }

  function affected(fx) {
    return GAUGES.filter((G) => fx[G.key]).map((G) => G.label).join(', ');
  }

  function apply(side) {
    if (busy || !current) return;
    busy = true;
    const fx = current[side].fx;
    // Le choix, plus l'usure quotidienne (frais + fatigue).
    const delta = {};
    for (const G of GAUGES) delta[G.key] = (fx[G.key] || 0) + (DRIFT[G.key] || 0);
    for (const k in g) g[k] = g[k] + delta[k];
    // mort si une jauge se vide ou déborde (avant clamp)
    let death = null;
    for (const G of GAUGES) {
      if (g[G.key] <= 0) { death = G.bas; break; }
      if (g[G.key] >= 100) { death = G.haut; break; }
    }
    for (const k in g) g[k] = clamp(g[k]);
    updateGauges(delta);
    $('choices').hidden = true; // on laisse l'animation des jauges jouer
    if (death) { setTimeout(() => end(false, death), 640); return; }
    jour++;
    if (jour > MAX_JOUR) { setTimeout(() => end(true), 640); return; }
    setTimeout(showCard, 360);
  }

  function end(win, cause) {
    $('card').hidden = true;
    $('choices').hidden = true;
    $('intro').hidden = true;
    const end = $('end');
    end.hidden = false;
    if (win) {
      $('endKicker').textContent = 'Rideau final';
      const p = g.presse, pub = g.public;
      let titre, txt;
      if (p >= 68) { titre = 'Révélation du OFF'; txt = "Vous avez tenu le mois entier et la presse ne parle que de vous. Un producteur vous embarque en tournée : le pari est gagné."; }
      else if (p >= 42 || pub >= 60) { titre = 'Le mois est sauvé'; txt = "Vous êtes allé·es au bout, avec quelques belles salles et deux ou trois dates décrochées pour la suite. Honorable, et déjà beaucoup."; }
      else { titre = 'Vous avez survécu'; txt = "Trois semaines de théâtre, la troupe debout et la caisse à l'équilibre. Personne ne vous a repéré·es, mais vous êtes encore là. À refaire."; }
      $('endTitle').textContent = titre;
      $('endTxt').textContent = txt;
      $('endScore').innerHTML = `Trésorerie <b>${g.treso}</b> · Public <b>${g.public}</b> · Moral <b>${g.moral}</b> · Presse <b>${g.presse}</b>`;
    } else {
      $('endKicker').textContent = `Jour ${jour} sur ${MAX_JOUR}`;
      $('endTitle').textContent = 'Le rideau tombe trop tôt';
      $('endTxt').textContent = cause;
      $('endScore').innerHTML = `Vous avez tenu <b>${jour - 1}</b> représentation${jour - 1 > 1 ? 's' : ''}.`;
    }
  }

  function reset() {
    g = { ...START };
    jour = 1;
    bag = [];
    lastCard = null;
    busy = false;
    buildGauges();
    showCard();
  }

  // ---- Interaction : boutons ----
  $('start').addEventListener('click', reset);
  $('again').addEventListener('click', reset);
  $('btnL').addEventListener('click', () => apply('L'));
  $('btnR').addEventListener('click', () => apply('R'));
  $('btnL').addEventListener('mouseenter', () => showHint('L'));
  $('btnR').addEventListener('mouseenter', () => showHint('R'));
  $('btnL').addEventListener('mouseleave', hideHints);
  $('btnR').addEventListener('mouseleave', hideHints);

  function showHint(side) {
    if (!current) return;
    const el = side === 'L' ? $('hintL') : $('hintR');
    el.textContent = 'Influence : ' + affected(current[side].fx);
    el.style.opacity = '1';
  }
  function hideHints() { $('hintL').style.opacity = '0'; $('hintR').style.opacity = '0'; }

  // ---- Interaction : glisser la carte ----
  const card = $('card');
  let dragging = false, startX = 0, dx = 0;
  function resetCardPos() { card.style.transition = 'transform .25s ease'; card.style.transform = ''; hideHints(); }
  card.addEventListener('pointerdown', (e) => { dragging = true; startX = e.clientX; card.style.transition = 'none'; card.setPointerCapture(e.pointerId); });
  card.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    dx = e.clientX - startX;
    card.style.transform = `translateX(${dx}px) rotate(${dx / 22}deg)`;
    if (dx < -24) showHint('L'); else if (dx > 24) showHint('R'); else hideHints();
  });
  card.addEventListener('pointerup', () => {
    if (!dragging) return; dragging = false;
    if (dx < -80) { card.style.transition = 'transform .2s ease'; card.style.transform = 'translateX(-140%) rotate(-16deg)'; setTimeout(() => apply('L'), 150); }
    else if (dx > 80) { card.style.transition = 'transform .2s ease'; card.style.transform = 'translateX(140%) rotate(16deg)'; setTimeout(() => apply('R'), 150); }
    else resetCardPos();
    dx = 0;
  });

  // ---- Clavier ----
  document.addEventListener('keydown', (e) => {
    if ($('choices').hidden) return;
    if (e.key === 'ArrowLeft') apply('L');
    if (e.key === 'ArrowRight') apply('R');
  });

  buildGauges();
</script>

