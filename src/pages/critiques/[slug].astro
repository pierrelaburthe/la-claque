---
import Base from '../../layouts/Base.astro';
import Stars from '../../components/Stars.astro';
import Avatar from '../../components/Avatar.astro';
import PieceCard from '../../components/PieceCard.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { PIECES } from '../../data/pieces';
import { CRITICS, criticSlug } from '../../data/critics';
import { verdictFor, nbVus, estPlebiscite, starsFor, seenLabel } from '../../lib/rating';
import { relatedPieces } from '../../lib/related';
import { categorieFor } from '../../lib/categories';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return PIECES.map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

const { piece } = Astro.props;
const c = CRITICS[piece.signataire];
const seen = nbVus(piece);
const pleb = estPlebiscite(piece);
const chef = piece.noteMoy >= 8;
const categorie = categorieFor(piece.style);

// Maillage : des critiques vraiment voisines (catégorie, salle, plume),
// et non les mêmes têtes de gondole sur chaque page.
const suggestions = relatedPieces(piece, PIECES, 3);

// Guides contextuels : ceux qui aident vraiment à prolonger cette critique.
const guideSlugs = Array.from(new Set([
  ...(piece.salle ? ['salles-du-off-avignon'] : []),
  'off-avignon-mode-demploi',
  'lexique-du-theatre',
]));

const hostname = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; }
};

const abs = (p: string) => new URL(url(p), Astro.site).href;
const ogImage = piece.image ? abs(piece.image) : undefined;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: `Critique : ${piece.titre}`,
    reviewBody: piece.chapo,
    datePublished: '2026-07-24',
    itemReviewed: {
      '@type': 'CreativeWork',
      name: piece.titre,
      genre: piece.style,
      ...(piece.origine ? { description: piece.origine } : {}),
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: starsFor(piece.noteMoy),
      bestRating: 5,
      worstRating: 1,
    },
    author: { '@type': 'Person', name: c.plume, url: abs(`/equipe/${criticSlug(c)}`) },
    publisher: { '@type': 'Organization', name: 'La Claque' },
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Critiques', item: abs('/critiques') },
      { '@type': 'ListItem', position: 3, name: piece.titre, item: abs(`/critiques/${piece.slug}`) },
    ],
  },
];
---
<Base title={`${piece.titre} — La Claque`} active="critiques" description={piece.chapo} jsonld={jsonld} image={ogImage}>
  <div class="art-hero">
    <div class="art-bg" style={piece.image ? `background-image:url(${url(piece.image)})` : `background:${c.couleur}`}></div>
    <div class="wrap art-hero-in">
      <a href={url('/critiques')} class="back">← Toutes les critiques</a>
      <div class="art-head">
        {piece.image && (
          <div class="art-poster"><img src={url(piece.image)} alt={`Affiche de ${piece.titre}`} /></div>
        )}
        <div class="art-title">
          <p class="sub">{piece.style}{piece.salle ? ` · ${piece.salle}` : ''}</p>
          <h1>{piece.titre}</h1>
          <div class="rating">
            <Stars note={piece.noteMoy} />
            <span class="flag">{verdictFor(piece.noteMoy)}</span>
            {pleb && <span class="flag"><span class="dot"></span> Plébiscite · {seenLabel(seen)}</span>}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
  <article class="art-body">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › <a href={url('/critiques')}>Critiques</a> › {piece.titre}</p>
    <div class="byline-row">
      <Avatar critic={piece.signataire} size={48} />
      <div class="who">
        <div class="n">Par <a href={url(`/equipe/${criticSlug(c)}`)} rel="author">{c.plume}</a></div>
        <div class="r">{c.role}</div>
      </div>
      <div class="crit-topics">
        <a href={url(`/critiques?cat=${encodeURIComponent(categorie)}`)}>{categorie}</a>
        {piece.salle && <a href={url('/guides/salles-du-off-avignon')}>{piece.salle}</a>}
      </div>
    </div>

    {piece.titreExact && piece.titreExact !== piece.titre && (
      <p class="metaline" style="margin:-10px 0 14px">Titre complet : {piece.titreExact}</p>
    )}
    {piece.origine && <p class="metaline" style="margin:-6px 0 8px; color:var(--ink-2)">{piece.origine}</p>}
    {piece.festival && <p class="metaline" style="margin:0 0 20px; color:var(--ink-3)">Dossier : {piece.festival}</p>}

    <p class="stand">{piece.chapo}</p>

    <div class="prose">
      {piece.corps.map((par) => <p>{par}</p>)}
    </div>

    {piece.momentGarde && (
      <div class="moment">
        <div class="lbl">Le moment qu'on garde</div>
        <p>{piece.momentGarde}</p>
      </div>
    )}

    <div class="artfoot">
      <Stars note={piece.noteMoy} />
      <span class="big">{verdictFor(piece.noteMoy)}</span>
      <span>vu par {seen} d'entre nous</span>
    </div>

    {piece.sources.length > 0 && (
      <p class="sources">
        Faits de production (autrice ou auteur, mise en scène, salle, synopsis) d'après
        {piece.sources.map((u, i) => (
          <> {i > 0 ? '· ' : ' '}<a href={u} rel="noopener nofollow">{hostname(u)}</a></>
        ))}. Les impressions de salle sont les nôtres.
      </p>
    )}
  </article>
  </div>

  <div class="wrap">
    <div class="rubric">
      <h2>Dans le même esprit</h2>
      <span class="line"></span>
      <span class="note">Nos critiques voisines</span>
    </div>
    <div class="cards">
      {suggestions.map((p) => <PieceCard piece={p} />)}
    </div>
  </div>

  <div class="wrap-narrow">
    <RelatedGuides slugs={guideSlugs} />
  </div>
</Base>

<style>
  .crit-topics { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; align-self: center; }
  .crit-topics a {
    font-family: var(--sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; text-decoration: none; color: var(--ink-2);
    border: 1px solid var(--rule-2); border-radius: 999px; padding: 5px 12px;
    transition: all 0.12s ease;
  }
  .crit-topics a:hover { border-color: var(--ink); color: var(--ink); background: var(--card); }
  @media (max-width: 560px) {
    .crit-topics { margin-left: 0; width: 100%; margin-top: 4px; }
  }
</style>
