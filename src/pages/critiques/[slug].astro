---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Stars from '../../components/Stars.astro';
import PieceCard from '../../components/PieceCard.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import Claquer from '../../components/Claquer.astro';
import { affiche } from '../../lib/images';
import { PIECES } from '../../data/pieces';
import { AUTHOR } from '../../data/author';
import { verdictFor, nbVus, estPlebiscite, starsFor, seenLabel } from '../../lib/rating';
import { relatedPieces } from '../../lib/related';
import { categorieFor } from '../../lib/categories';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return PIECES.map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

const { piece } = Astro.props;
const seen = nbVus(piece);
const pleb = estPlebiscite(piece);
const chef = piece.noteMoy >= 8;
const categorie = categorieFor(piece.style);

// Maillage : des critiques vraiment voisines (catégorie, salle, plume),
// et non les mêmes têtes de gondole sur chaque page.
const suggestions = relatedPieces(piece, PIECES, 3);

// Guides contextuels : ceux qui aident vraiment à prolonger cette critique.
// Ils dépendent du dossier : renvoyer un spectacle parisien vers le guide des
// salles du OFF n'aurait aucun sens.
const estAvignon = (piece.festival ?? '').includes('Avignon');
const guideSalles = estAvignon ? 'salles-du-off-avignon' : 'theatre-a-paris-guide-des-salles';
const guideSlugs = Array.from(new Set([
  ...(piece.salle ? [guideSalles] : []),
  ...(estAvignon ? ['off-avignon-mode-demploi'] : ['choisir-sa-place-au-theatre']),
  // Le lecteur d'une critique parisienne cherche souvent d'abord une place
  // abordable ; sur un spectacle d'Avignon, la question ne se pose pas pareil.
  ...(estAvignon ? [] : ['theatre-pas-cher-a-paris']),
  'lexique-du-theatre',
]));

// L'affiche : 208 px à l'écran (150 sur mobile), donc 208 servis en WebP,
// doublés pour les écrans denses.
const img = affiche(piece.image);
// Le fond du bandeau est la même affiche passée à `blur(40px)`. Elle était
// servie en pleine résolution pour finir illisible : 48 px de large suffisent
// largement, et le flou masque complètement la perte.
const fond = img ? await getImage({ src: img, width: 48, format: 'webp' }) : null;

const hostname = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; }
};

const abs = (p: string) => new URL(url(p), Astro.site).href;
const ogImage = abs(`/og/${piece.slug}.png`);
const critiqueUrl = abs(`/critiques/${piece.slug}`);

// Dates : publication du dossier, et dernière mise à jour (resync du tableur).
// Une critique publiée plus tard, ou vraiment retouchée, porte les siennes
// (champs `datePubli` / `dateMaj` de la pièce).
const DATE_PUBLI = '2026-07-24';
const DATE_MAJ = '2026-07-25';
const datePubli = piece.datePubli ?? DATE_PUBLI;
const dateMaj = piece.dateMaj ?? piece.datePubli ?? DATE_MAJ;

// Réservation. Le OFF d'Avignon 2026 est terminé : renvoyer vers sa billetterie
// en promettant « Trouver les billets » induirait le lecteur en erreur. On ne
// propose donc de réserver que si des dates à venir ont été vérifiées
// (champ `reprise`). Sinon on se contente de la fiche du spectacle.
const DATE_VERIF = '28 juillet 2026';
const ficheUrl = piece.sources.find((u) => /billetreduc|ticketoff|festivaloffavignon/.test(u)) || piece.sources[0];

// Meta description : on met en tête ce qu'aucune billetterie n'affiche, la note
// et le nombre de claqueurs qui l'ont portée. Sur une requête « titre + avis »,
// c'est le seul argument qui puisse nous faire préférer à Ticket'Off ou
// BilletReduc, qui sortent sur les mêmes mots avec la seule fiche du spectacle.
const descriptionSerp = `${starsFor(piece.noteMoy)} étoiles sur 5, vu et noté par ${seen > 1 ? seenLabel(seen) : 'un claqueur'}. ${piece.chapo}`;

// Partage social (liens construits côté serveur, un seul bouton en JS pour la copie).
const enc = encodeURIComponent;
const shareTitle = `${piece.titre} : la critique de La Claque`;
const share = {
  x: `https://twitter.com/intent/tweet?text=${enc(shareTitle)}&url=${enc(critiqueUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(critiqueUrl)}`,
  whatsapp: `https://wa.me/?text=${enc(shareTitle + ' ' + critiqueUrl)}`,
  email: `mailto:?subject=${enc(shareTitle)}&body=${enc('À voir : ' + critiqueUrl)}`,
};

// Le spectacle noté, décrit pour les moteurs. Le choix du type n'est pas
// cosmétique : Google n'affiche d'étoiles d'avis que si l'objet noté appartient
// à une liste de types précise, où `CreativeWork` ne figure pas et `Event` si.
// Or un spectacle EST un événement. Quand une reprise est datée au jour près et
// localisée, on le dit en `TheaterEvent` et la critique redevient éligible aux
// étoiles ; sans date exacte, l'événement serait incomplet (`startDate` est
// obligatoire) donc invalide, et on retombe sur la description d'œuvre.
const rep = piece.reprise;

// Les autres écritures du titre : le titre complet quand il diffère de celui
// qu'on affiche, plus les variantes d'orthographe. Rien de tout ça n'est
// visible ; ça sert à rapprocher la page des recherches « anticocon » ou
// « munchhausen », qui sont les mêmes spectacles.
const alternateName = Array.from(new Set([
  ...(piece.titreExact && piece.titreExact !== piece.titre ? [piece.titreExact] : []),
  ...(piece.alias ?? []),
]));

// La note agrégée. `ratingValue` reprend exactement les étoiles affichées par
// le composant Stars : la moyenne sur 10 ne sort jamais à l'écran, elle n'a
// donc rien à faire dans le balisage. `ratingCount`, c'est le nombre de
// claqueurs qui ont vu et noté, celui-là même qu'annonce la page. C'est ce que
// les billetteries n'ont pas : un avis porté par plusieurs regards.
const aggregateRating = {
  '@type': 'AggregateRating',
  ratingValue: starsFor(piece.noteMoy),
  bestRating: 5,
  worstRating: 1,
  ratingCount: seen,
};

const lieuReprise = rep?.salle
  ? {
      '@type': 'PerformingArtsTheater',
      name: rep.salle,
      ...(rep.ville
        ? { address: { '@type': 'PostalAddress', addressLocality: rep.ville, addressCountry: 'FR' } }
        : {}),
    }
  : rep?.ville
    ? {
        '@type': 'Place',
        name: rep.ville,
        address: { '@type': 'PostalAddress', addressLocality: rep.ville, addressCountry: 'FR' },
      }
    : null;

const itemReviewed = rep?.debut && lieuReprise
  ? {
      '@type': 'TheaterEvent',
      name: piece.titre,
      ...(alternateName.length ? { alternateName } : {}),
      url: rep.url,
      startDate: rep.debut,
      ...(rep.fin ? { endDate: rep.fin } : {}),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: lieuReprise,
      ...(piece.origine ? { description: piece.origine } : {}),
      aggregateRating,
    }
  : {
      '@type': 'CreativeWork',
      name: piece.titre,
      ...(alternateName.length ? { alternateName } : {}),
      genre: piece.style,
      ...(piece.origine ? { description: piece.origine } : {}),
      aggregateRating,
    };

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: `Critique : ${piece.titre}`,
    reviewBody: piece.chapo,
    datePublished: datePubli,
    dateModified: dateMaj,
    itemReviewed,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: starsFor(piece.noteMoy),
      bestRating: 5,
      worstRating: 1,
    },
    author: {
      '@type': 'Person',
      name: AUTHOR.nom,
      url: abs('/equipe#auteur'),
      jobTitle: AUTHOR.role,
      ...(AUTHOR.sameAs.length ? { sameAs: AUTHOR.sameAs } : {}),
    },
    publisher: { '@type': 'Organization', name: 'La Claque' },
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: critiqueUrl,
    datePublished: datePubli,
    dateModified: dateMaj,
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.stand'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Critiques', item: abs('/critiques') },
      { '@type': 'ListItem', position: 3, name: piece.titre, item: abs(`/critiques/${piece.slug}`) },
    ],
  },
];
---
<Base title={`${piece.titre} : critique et avis${piece.festival ? ` (${piece.festival})` : ''} | La Claque`} active="critiques" description={descriptionSerp} jsonld={jsonld} image={ogImage}>
  <div class="art-hero">
    <div class="art-bg" style={fond ? `background-image:url(${fond.src})` : 'background:var(--red)'}></div>
    <div class="wrap art-hero-in">
      <a href={url('/critiques')} class="back">← Toutes les critiques</a>
      <div class="art-head">
        {img && (
          <div class="art-poster">
            <Image
              src={img}
              alt={`Affiche de ${piece.titre}`}
              width={208}
              densities={[1, 2]}
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}
        <div class="art-title">
          <p class="sub">{piece.style}{piece.salle ? ` · ${piece.salle}` : ''}</p>
          <h1>{piece.titre}</h1>
          <div class="rating">
            <Stars note={piece.noteMoy} />
            <span class="flag">{verdictFor(piece.noteMoy)}</span>
            {pleb && <span class="flag"><span class="dot"></span> Plébiscite · {seenLabel(seen)}</span>}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
  <article class="art-body">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › <a href={url('/critiques')}>Critiques</a> › {piece.titre}</p>
    <div class="byline-row">
      <div class="who">
        <div class="n">Vu par {seenLabel(seen)} de la bande</div>
        <div class="r"><a href={url('/equipe#auteur')} rel="author">Qui écrit ici</a></div>
      </div>
      <div class="crit-topics">
        <a href={url(`/critiques?cat=${encodeURIComponent(categorie)}`)}>{categorie}</a>
        {piece.salle && <a href={url(`/guides/${guideSalles}`)}>{piece.salle}</a>}
      </div>
    </div>

    {piece.titreExact && piece.titreExact !== piece.titre && (
      <p class="metaline" style="margin:-10px 0 14px">Titre complet : {piece.titreExact}</p>
    )}
    {piece.origine && <p class="metaline" style="margin:-6px 0 8px; color:var(--ink-2)">{piece.origine}</p>}
    {piece.festival && <p class="metaline" style="margin:0 0 20px; color:var(--ink-3)">Dossier : {piece.festival}</p>}

    <p class="stand">{piece.chapo}</p>

    <div class="prose">
      {piece.corps.map((par) => <p>{par}</p>)}
    </div>

    {piece.momentGarde && (
      <div class="moment">
        <div class="lbl">Le moment qu'on garde</div>
        <p>{piece.momentGarde}</p>
      </div>
    )}

    <div class="artfoot">
      <Stars note={piece.noteMoy} />
      <span class="big">{verdictFor(piece.noteMoy)}</span>
    </div>

    <Claquer slug={piece.slug} titre={piece.titre} />

    <aside class="pratique" class:list={['pratique', piece.reprise && 'pratique-on']}>
      <p class="pr-lbl">{piece.reprise ? `Où voir « ${piece.titre} » en ce moment` : `Où nous avons vu « ${piece.titre} »`}</p>
      {piece.reprise ? (
        <div class="pr-rows">
          <div class="pr-row"><span>À l'affiche</span><strong>{piece.reprise.lieu}</strong></div>
          <div class="pr-row"><span>Dates</span><strong>{piece.reprise.dates}</strong></div>
          <div class="pr-row"><span>Genre</span><strong>{piece.style}</strong></div>
        </div>
      ) : (
        <div class="pr-rows">
          {piece.salle && <div class="pr-row"><span>Salle</span><strong>{piece.salle}</strong></div>}
          {piece.festival && <div class="pr-row"><span>Dossier</span><strong>{piece.festival}</strong></div>}
          <div class="pr-row"><span>Genre</span><strong>{piece.style}</strong></div>
        </div>
      )}
      {piece.reprise
        ? <a class="btn pr-btn" href={piece.reprise.url} target="_blank" rel="noopener nofollow">Réserver →</a>
        : ficheUrl && <a class="btn btn-ghost pr-btn" href={ficheUrl} target="_blank" rel="noopener nofollow">Voir la fiche du spectacle →</a>}
      <p class="pr-note">
        {piece.reprise
          ? `Dates vérifiées le ${DATE_VERIF}. Les théâtres les font parfois évoluer, la billetterie fait foi.`
          : `Nous n'avons pas trouvé de date à venir au ${DATE_VERIF}. Cela ne veut pas dire que le spectacle ne tourne plus : les compagnies annoncent souvent leur saison plus tard.`}
      </p>
    </aside>

    <div class="share">
      <span class="share-lbl">Faites tourner</span>
      <div class="share-btns">
        <a class="sb" href={share.x} target="_blank" rel="noopener" aria-label="Partager sur X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.7 21h-6l-4.7-6.1L5.6 21H2.6l7-8L2.3 3h6.1l4.2 5.6L17.5 3Zm-1 16h1.7L7.6 4.8H5.8L16.5 19Z"/></svg>
        </a>
        <a class="sb" href={share.facebook} target="_blank" rel="noopener" aria-label="Partager sur Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V7c0-.9.2-1.4 1.5-1.4H17V3h-2.6C11.6 3 11 4.6 11 6.7v1.8H9V11h2v10h3V11h2.2l.3-2.5H14Z"/></svg>
        </a>
        <a class="sb" href={share.whatsapp} target="_blank" rel="noopener" aria-label="Partager sur WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Zm0 16.3a7.3 7.3 0 0 1-3.7-1l-.3-.2-2.7.7.7-2.6-.2-.3A7.3 7.3 0 1 1 12 19.3Zm4.1-5.4c-.2-.1-1.3-.7-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6 6 0 0 1-3-2.6c-.2-.4.2-.4.6-1.1.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.8.8-.8 2 0 3.2a9 9 0 0 0 3.5 3.1c1.3.6 1.8.6 2.5.5.4 0 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1l-.5-.2Z"/></svg>
        </a>
        <a class="sb" href={share.email} aria-label="Partager par e-mail">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 2.2V8l8 5 8-5v-.8l-8 5-8-5Z"/></svg>
        </a>
        <button class="sb copy" id="shareCopy" type="button" data-url={critiqueUrl} data-title={shareTitle} aria-label="Copier le lien">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1.3 1.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14.5 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1.3-1.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <span class="share-done" id="shareCopied" hidden>Lien copié</span>
      </div>
    </div>

    {piece.sources.length > 0 && (
      <p class="sources">
        Faits de production (autrice ou auteur, mise en scène, salle, synopsis) d'après
        {piece.sources.map((u, i) => (
          <> {i > 0 ? '· ' : ' '}<a href={u} rel="noopener nofollow">{hostname(u)}</a></>
        ))}. Les impressions de salle sont les nôtres.
      </p>
    )}
  </article>
  </div>

  <div class="wrap">
    <div class="rubric">
      <h2>Dans le même esprit</h2>
      <span class="line"></span>
      <span class="note">Nos critiques voisines</span>
    </div>
    <div class="cards">
      {suggestions.map((p) => <PieceCard piece={p} />)}
    </div>
  </div>

  <div class="wrap-narrow">
    <RelatedGuides slugs={guideSlugs} />
  </div>
</Base>

<script>
  const btn = document.getElementById('shareCopy');
  if (btn) {
    btn.addEventListener('click', async () => {
      const u = btn.dataset.url, t = btn.dataset.title;
      try {
        if (navigator.share) { await navigator.share({ title: t, url: u }); return; }
      } catch (e) { if (e && e.name === 'AbortError') return; }
      try { await navigator.clipboard.writeText(u); } catch (e) {}
      const done = document.getElementById('shareCopied');
      if (done) { done.hidden = false; clearTimeout(done._t); done._t = setTimeout(() => { done.hidden = true; }, 2500); }
    });
  }
</script>

<style>
  .pratique { background: var(--card); border: 1px solid var(--rule-2); border-left: 4px solid var(--red); padding: 20px 22px; margin: 30px 0 6px; }
  .pratique .pr-lbl { font-family: var(--sans); font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.09em; color: var(--ink-3); margin: 0 0 14px; }
  .pratique .pr-rows { display: flex; flex-wrap: wrap; gap: 10px 34px; margin-bottom: 18px; }
  .pratique .pr-row { display: flex; flex-direction: column; }
  .pratique .pr-row span { font-family: var(--sans); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .pratique .pr-row strong { font-family: var(--serif); font-size: 1.05rem; color: var(--ink); }
  .pratique .pr-btn { display: inline-block; }
  .pratique.pratique-on { border-left-color: var(--red); }
  .pratique .pr-note { margin: 14px 0 0; font-family: var(--sans); font-size: 0.74rem; line-height: 1.5; color: var(--ink-3); }

  .share { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin: 30px 0 6px; padding-top: 22px; border-top: 1px solid var(--rule); }
  .share-lbl { font-family: var(--sans); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .share-btns { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .share .sb { width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--rule-2); border-radius: 50%; color: var(--ink); background: var(--paper); cursor: pointer; transition: all 0.12s ease; padding: 0; }
  .share .sb svg { width: 19px; height: 19px; fill: currentColor; }
  .share .sb:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); transform: translateY(-2px); }
  .share-done { font-family: var(--sans); font-size: 0.75rem; font-weight: 700; color: var(--red); }

  .crit-topics { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; align-self: center; }
  .crit-topics a {
    font-family: var(--sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; text-decoration: none; color: var(--ink-2);
    border: 1px solid var(--rule-2); border-radius: 999px; padding: 5px 12px;
    transition: all 0.12s ease;
  }
  .crit-topics a:hover { border-color: var(--ink); color: var(--ink); background: var(--card); }
  @media (max-width: 560px) {
    .crit-topics { margin-left: 0; width: 100%; margin-top: 4px; }
  }
</style>
