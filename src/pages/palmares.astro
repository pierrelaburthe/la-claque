---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import { affiche } from '../lib/images';
import { PIECES } from '../data/pieces';
import { nbVus, estPlebiscite, verdictFor, seenLabel, consensusScore } from '../lib/rating';
import { url } from '../lib/url';

// À note comparable, ce que le plus grand nombre a vu passe devant (consensusScore).
const classement = [...PIECES].sort((a, b) => consensusScore(b) - consensusScore(a));

// On range par taille de claque, et la numérotation repart à 1 dans chaque
// groupe : comparer un cinq étoiles à un trois étoiles dans un même classement
// continu n'avait pas de sens.
const GROUPES = [
  { verdict: 'Grosse claque', note: 'Cinq étoiles', intro: "Le haut du panier. Ceux dont on parlera encore l'an prochain." },
  { verdict: 'Belle claque', note: 'Quatre étoiles', intro: 'Les valeurs sûres, celles qu\'on recommande sans hésiter.' },
  { verdict: 'Petite claque', note: 'Trois étoiles', intro: "Des spectacles plus singuliers, à choisir selon ses goûts. Chacun nous a donné une raison d'applaudir." },
];
const groupes = GROUPES
  .map((g) => ({ ...g, pieces: classement.filter((p) => verdictFor(p.noteMoy) === g.verdict) }))
  .filter((g) => g.pieces.length > 0);
---
<Base title="Palmarès : nos meilleures critiques de théâtre | La Claque" active="palmares" description={`Le classement de nos ${PIECES.length} critiques de théâtre, du OFF d'Avignon aux salles parisiennes, rangées par taille de claque : grosses claques, belles claques, petites claques.`}>
  <div class="wrap">
    <div class="rubric" style="margin-top:40px">
      <h2>Le palmarès 2026</h2>
      <span class="line"></span>
      <span class="note">De la claque à la caresse</span>
    </div>
    <p class="rubric-intro">Les {classement.length} spectacles rangés par taille de claque, et classés à l'intérieur de chaque groupe. À note comparable, on fait remonter ce que le plus grand nombre de claqueurs a vu : une belle note partagée par toute la bande pèse plus lourd qu'un coup de cœur solitaire. La pastille signale les plébiscites, vus en nombre et adorés ensemble.</p>

    {groupes.map((g) => (
    <section class="palm-groupe">
      <div class="rubric palm-titre">
        <h2>{g.verdict}</h2>
        <span class="line"></span>
        <span class="note">{g.note} · {g.pieces.length} spectacle{g.pieces.length > 1 ? 's' : ''}</span>
      </div>
      <p class="rubric-intro">{g.intro}</p>
    <ol class="rank">
      {g.pieces.map((p, i) => {
        const seen = nbVus(p);
        return (
          <li>
            <a href={url(`/critiques/${p.slug}`)}>
              <span class="pos">{i + 1}</span>
              <span class="thumb">
                {affiche(p.image)
                  ? <Image src={affiche(p.image)!} alt={`Affiche de ${p.titre}`} width={52} densities={[1, 2]} format="webp" loading="lazy" decoding="async" />
                  : <span class="ph"></span>}
              </span>
              <span class="main">
                <strong>{p.titre}{estPlebiscite(p) && <span class="dot" title="Plébiscite"></span>}</strong>
                <span class="sub">{p.style}{p.salle ? ` · ${p.salle}` : ''}</span>
              </span>
              <span class="rating">
                <Stars note={p.noteMoy} />
                <span class="verdict">{verdictFor(p.noteMoy)}</span>
              </span>
              <span class="seen-col">{seenLabel(seen)}</span>
            </a>
          </li>
        );
      })}
    </ol>
    </section>
    ))}
  </div>
</Base>

<style>
  .palm-groupe { margin-bottom: 46px; }
  .palm-titre { margin-top: 34px; }
  .rank { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; }
  .rank li { border-bottom: 1px solid var(--rule); }
  .rank li:first-child { border-top: 1px solid var(--rule); }
  .rank a {
    display: grid; grid-template-columns: 42px 52px 1fr auto auto; align-items: center; gap: 18px;
    padding: 12px 6px; text-decoration: none; color: var(--ink);
  }
  .rank a:hover { background: var(--card); }
  .rank a:hover strong { color: var(--red); }
  .pos { font-family: var(--display); font-size: 1.6rem; color: var(--ink-3); font-weight: 600; text-align: center; }
  .thumb { width: 52px; height: 66px; overflow: hidden; border: 1px solid var(--rule-2); background: var(--panel); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb .ph { display: block; width: 100%; height: 100%; }
  .main { display: flex; flex-direction: column; min-width: 0; }
  .main strong { font-family: var(--serif); font-size: 1.2rem; display: flex; align-items: center; gap: 8px; }
  .main .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red); flex: none; }
  .main .sub { font-family: var(--sans); font-size: 0.74rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.05em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rating { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; min-width: 118px; }
  .rating .stars { font-size: 1.15rem; }
  .rating .verdict { font-family: var(--sans); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); font-weight: 700; }
  .seen-col { font-family: var(--sans); font-weight: 700; font-size: 0.66rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; text-align: right; min-width: 66px; }
  @media (max-width: 680px) {
    .rank a { grid-template-columns: 30px 44px 1fr auto; gap: 12px; }
    .seen-col { display: none; }
    .thumb { width: 44px; height: 56px; }
  }
</style>
