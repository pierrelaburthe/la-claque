---
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import Stars from '../components/Stars.astro';
import Avatar from '../components/Avatar.astro';
import { PIECES } from '../data/pieces';
import { CRITICS } from '../data/critics';
import { consensusScore, estDecouverteSolo, nbVus, verdictFor } from '../lib/rating';
import { url } from '../lib/url';

const parConsensus = [...PIECES].sort((a, b) => consensusScore(b) - consensusScore(a));
const une = parConsensus[0];
const side = parConsensus.slice(1, 6);
const featured = new Set([une, ...side].map((p) => p.slug));

const chefs = PIECES.filter((p) => p.noteMoy >= 8 && !featured.has(p.slug)).sort((a, b) => b.noteMoy - a.noteMoy);
const solos = PIECES.filter(estDecouverteSolo).sort((a, b) => b.noteMoy - a.noteMoy);

const totalVues = PIECES.reduce((s, p) => s + nbVus(p), 0);
const c = CRITICS[une.signataire];
const ogImage = une.image ? new URL(url(une.image), Astro.site).href : undefined;
---
<Base title="La Claque — critiques de théâtre" active="accueil" image={ogImage}>
  <div class="frontline">
    <div class="inner">
      <span>Festival OFF d'Avignon 2026 · Dossier nº1</span>
      <span><b>{PIECES.length} critiques</b> · une dizaine de plumes · {totalVues} paires d'yeux</span>
    </div>
  </div>

  <div class="wrap">
    <section class="frontpage">
      <article class="lead-story">
        <a class="lead-frame" href={url(`/critiques/${une.slug}`)}>
          {une.image && <img src={url(une.image)} alt={`Affiche de ${une.titre}`} />}
          <span class="corner">La Une</span>
        </a>
        <div class="lead-body">
          <span class="lead-kicker">{une.style}{une.salle ? ` · ${une.salle}` : ''}</span>
          <h1><a href={url(`/critiques/${une.slug}`)}>{une.titre}</a></h1>
          <p class="lead-stand">{une.chapo}</p>
          <div class="lead-foot">
            <Stars note={une.noteMoy} />
            <span class="metaline">{verdictFor(une.noteMoy)} · {nbVus(une)} paires d'yeux</span>
          </div>
          <div class="byl" style="margin-top:12px">
            <Avatar critic={une.signataire} size={24} ring={false} /> Par {c.plume}
          </div>
        </div>
      </article>

      <aside class="front-side">
        <h2 class="side-title">À l'affiche</h2>
        <ol class="side-list">
          {side.map((p, i) => (
            <li>
              <a href={url(`/critiques/${p.slug}`)}>
                <span class="rk">{i + 2}</span>
                <span class="th">{p.image && <img src={url(p.image)} alt={`Affiche de ${p.titre}`} loading="lazy" />}</span>
                <span>
                  <span class="st">{p.titre}</span>
                  <span class="sm">{verdictFor(p.noteMoy)} · vu par {nbVus(p)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </section>

    <div class="manifesto">
      <p>La Claque, c'est une dizaine de comédien·nes qui courent les salles à plusieurs paires d'yeux et ne bouderont jamais leur plaisir. On note généreusement, on raconte, on partage nos coups de cœur.</p>
      <div class="actions">
        <a class="btn" href={url('/critiques')}>Les {PIECES.length} critiques</a>
        <a class="btn btn-ghost" href={url('/a-propos')}>Notre méthode</a>
      </div>
    </div>

    <div class="rubric">
      <h2>Les autres grosses claques</h2>
      <span class="line"></span>
      <span class="note">Cinq étoiles</span>
    </div>
    <p class="rubric-intro">Le haut du panier, au-delà de la une. À rattraper d'urgence.</p>
    <div class="cards">
      {chefs.map((p) => <PieceCard piece={p} />)}
    </div>

    <div class="rubric">
      <h2>Les découvertes en solo</h2>
      <span class="line"></span>
      <span class="note">Vues par un·e seul·e d'entre nous</span>
    </div>
    <p class="rubric-intro">Un membre de la bande s'est aventuré seul dans une salle et en est ressorti conquis. Des paris qu'on vous propose.</p>
    <div class="cards">
      {solos.map((p) => <PieceCard piece={p} />)}
    </div>

    <div class="center" style="margin:54px 0 10px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a class="btn" href={url('/palmares')}>Le palmarès complet</a>
      <a class="btn btn-ghost" href={url('/guides')}>Nos guides du théâtre</a>
    </div>
  </div>
</Base>
