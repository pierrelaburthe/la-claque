---
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import Stars from '../components/Stars.astro';
import { PIECES } from '../data/pieces';
import { AUTHOR } from '../data/author';
import { consensusScore, estDecouverteSolo, nbVus, verdictFor, seenLabel } from '../lib/rating';
import { url } from '../lib/url';

const parConsensus = [...PIECES].sort((a, b) => consensusScore(b) - consensusScore(a));
const une = parConsensus[0];
const side = parConsensus.slice(1, 6);
const featured = new Set([une, ...side].map((p) => p.slug));

const chefs = PIECES.filter((p) => p.noteMoy >= 8 && !featured.has(p.slug)).sort((a, b) => b.noteMoy - a.noteMoy);
const solos = PIECES.filter(estDecouverteSolo).sort((a, b) => b.noteMoy - a.noteMoy);

const ogImage = new URL(url(`/og/${une.slug}.png`), Astro.site).href;
---
<Base title="La Claque — critiques de théâtre" active="accueil" image={ogImage}>
  <div class="frontline">
    <div class="inner">
      <span>Festival OFF d'Avignon 2026 · Dossier nº1</span>
      <span><b>{PIECES.length} critiques</b> · une dizaine de claqueurs</span>
    </div>
  </div>

  <div class="wrap">
    <section class="frontpage">
      <article class="lead-story">
        <a class="lead-frame" href={url(`/critiques/${une.slug}`)}>
          {une.image && <img src={url(une.image)} alt={`Affiche de ${une.titre}`} />}
          <span class="corner">La Une</span>
        </a>
        <div class="lead-body">
          <span class="lead-kicker">{une.style}{une.salle ? ` · ${une.salle}` : ''}</span>
          <h1><a href={url(`/critiques/${une.slug}`)}>{une.titre}</a></h1>
          <p class="lead-stand">{une.chapo}</p>
          <div class="lead-foot">
            <Stars note={une.noteMoy} />
            <span class="metaline">{verdictFor(une.noteMoy)} · {seenLabel(nbVus(une))}</span>
          </div>
          <div class="byl" style="margin-top:12px">Par {AUTHOR.nom}</div>
        </div>
      </article>

      <aside class="front-side">
        <h2 class="side-title">À l'affiche</h2>
        <ol class="side-list">
          {side.map((p, i) => (
            <li>
              <a href={url(`/critiques/${p.slug}`)}>
                <span class="rk">{i + 2}</span>
                <span class="th">{p.image && <img src={url(p.image)} alt={`Affiche de ${p.titre}`} loading="lazy" />}</span>
                <span>
                  <span class="st">{p.titre}</span>
                  <span class="sm">{verdictFor(p.noteMoy)} · {seenLabel(nbVus(p))}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </section>

    <div class="manifesto">
      <p>La Claque, c'est une dizaine de comédien·nes qui courent les salles ensemble et ne bouderont jamais leur plaisir. Ils voient, on en discute, je rédige. On note généreusement et on partage nos coups de cœur.</p>
      <div class="actions">
        <a class="btn" href={url('/critiques')}>Les {PIECES.length} critiques</a>
        <a class="btn btn-ghost" href={url('/a-propos')}>Notre méthode</a>
      </div>
    </div>

    <div class="rubric">
      <h2>Les autres grosses claques</h2>
      <span class="line"></span>
      <span class="note">Cinq étoiles</span>
    </div>
    <p class="rubric-intro">Le haut du panier, au-delà de la une. À rattraper d'urgence.</p>
    <div class="cards">
      {chefs.map((p) => <PieceCard piece={p} />)}
    </div>

    <div class="rubric">
      <h2>Les découvertes en solo</h2>
      <span class="line"></span>
      <span class="note">Vues par un·e seul·e d'entre nous</span>
    </div>
    <p class="rubric-intro">Un membre de la bande s'est aventuré seul dans une salle et en est ressorti conquis. Des paris qu'on vous propose.</p>
    <div class="cards">
      {solos.map((p) => <PieceCard piece={p} />)}
    </div>

    <a class="game-teaser" href={url('/jouer')}>
      <span class="gt-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 6c4-1.4 12-1.4 16 0 0 8.4-3.1 13.4-8 13.4S4 14.4 4 6Z"/><circle cx="9.3" cy="10.6" r="1.1" fill="#fff" stroke="none"/><circle cx="14.7" cy="10.6" r="1.1" fill="#fff" stroke="none"/><path d="M9 14.1c1.4 1.3 4.6 1.3 6 0"/></svg>
      </span>
      <span class="gt-body">
        <span class="gt-kicker">Le jeu de La Claque</span>
        <strong>Un mois au OFF</strong>
        <span class="gt-txt">Dirigez une compagnie et tenez tout le festival sans vider la caisse ni épuiser la troupe. Un jeu de cartes à la Reigns.</span>
      </span>
      <span class="gt-cta">Jouer →</span>
    </a>

    <div class="center" style="margin:44px 0 10px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a class="btn" href={url('/palmares')}>Le palmarès complet</a>
      <a class="btn btn-ghost" href={url('/guides')}>Nos guides du théâtre</a>
    </div>
  </div>
</Base>

<style>
  .game-teaser {
    display: flex; align-items: center; gap: 22px; margin: 54px 0 6px;
    background: var(--ink); color: var(--paper); padding: 24px 28px;
    text-decoration: none; transition: transform 0.12s ease;
  }
  .game-teaser:hover { transform: translateY(-2px); }
  .gt-badge { flex: none; width: 62px; height: 62px; border-radius: 50%; background: var(--red); display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 0 2.5px rgba(255,255,255,0.3); }
  .gt-badge svg { width: 34px; height: 34px; fill: none; stroke: #fff; stroke-width: 2.3; stroke-linecap: round; stroke-linejoin: round; }
  .gt-body { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
  .gt-kicker { font-family: var(--sans); font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #f0c74a; }
  .gt-body strong { font-family: var(--display); font-weight: 700; font-size: 1.5rem; line-height: 1.1; }
  .gt-txt { font-family: var(--serif); font-size: 0.95rem; color: rgba(255,255,255,0.82); line-height: 1.4; }
  .gt-cta { flex: none; font-family: var(--sans); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid rgba(255,255,255,0.5); padding: 11px 18px; border-radius: 2px; white-space: nowrap; }
  .game-teaser:hover .gt-cta { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  @media (max-width: 620px) {
    .game-teaser { flex-wrap: wrap; gap: 16px; padding: 22px; }
    .gt-cta { width: 100%; text-align: center; }
  }
</style>
