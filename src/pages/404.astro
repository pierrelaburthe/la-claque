---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page introuvable — La Claque" description="Cette page n'existe pas ou plus.">
  <div class="wrap-narrow" style="padding:70px 0 40px; text-align:center;">
    <p class="kicker" style="justify-content:center">Erreur 404</p>
    <h1 style="font-size:clamp(2.2rem,6vw,3.6rem); margin:8px 0 14px;">Rideau. Cette page n'existe pas.</h1>
    <p class="stand" style="font-style:italic; color:var(--ink-2); max-width:52ch; margin:0 auto 28px;">
      Le lien s'est trompé de salle, ou la représentation est terminée. Pas de panique, le spectacle continue ailleurs.
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a class="btn" href={url('/')}>Retour à la une</a>
      <a class="btn btn-ghost" href={url('/critiques')}>Toutes les critiques</a>
    </div>
  </div>
</Base>
