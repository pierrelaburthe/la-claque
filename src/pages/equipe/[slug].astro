---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import PieceCard from '../../components/PieceCard.astro';
import { CRITICS, CRITIC_ORDER, criticSlug } from '../../data/critics';
import { PIECES } from '../../data/pieces';
import { consensusScore, nbVus } from '../../lib/rating';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return CRITIC_ORDER.map((key) => {
    const critic = CRITICS[key];
    const signees = PIECES.filter((p) => p.signataire === key);
    return { critic, signees };
  })
    .filter(({ signees }) => signees.length > 0)
    .map(({ critic, signees }) => ({ params: { slug: criticSlug(critic) }, props: { critic, signees } }));
}

const { critic, signees } = Astro.props;
const signed = [...signees].sort((a, b) => consensusScore(b) - consensusScore(a));
const notees = PIECES.filter((p) => p.notes[critic.key] !== undefined);

const abs = (p) => new URL(url(p), Astro.site).href;
const pageUrl = abs(`/equipe/${criticSlug(critic)}`);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: critic.plume,
      jobTitle: critic.role,
      description: critic.bio,
      url: pageUrl,
      worksFor: { '@type': 'Organization', name: 'La Claque', url: abs('/') },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Critiques signées ${critic.plume}`,
    itemListElement: signed.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: abs(`/critiques/${p.slug}`),
      name: p.titre,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'La rédaction', item: abs('/equipe') },
      { '@type': 'ListItem', position: 3, name: critic.plume, item: pageUrl },
    ],
  },
];
---
<Base
  title={`${critic.plume}, ${critic.role} — La Claque`}
  description={`${critic.plume}, ${critic.role.toLowerCase()} à La Claque : ${signed.length} critique${signed.length > 1 ? 's' : ''} de théâtre signée${signed.length > 1 ? 's' : ''}. ${critic.bio}`}
  active="equipe"
  jsonld={jsonld}
>
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › <a href={url('/equipe')}>La rédaction</a> › {critic.plume}</p>
    <header class="author-head" style={`--acc:${critic.couleur}`}>
      <Avatar critic={critic.key} size={92} />
      <div class="author-id">
        <p class="role">{critic.role}</p>
        <h1>{critic.plume}</h1>
        <p class="author-bio">{critic.bio}</p>
        <p class="author-stats">
          <span><strong>{signed.length}</strong> critique{signed.length > 1 ? 's' : ''} signée{signed.length > 1 ? 's' : ''}</span>
          <span><strong>{notees.length}</strong> spectacle{notees.length > 1 ? 's' : ''} vu{notees.length > 1 ? 's' : ''}</span>
        </p>
      </div>
    </header>
  </div>

  <div class="wrap">
    <div class="rubric">
      <h2>Ses critiques</h2>
      <span class="line"></span>
      <span class="note">Signées {critic.prenomScene}</span>
    </div>
    <div class="cards">
      {signed.map((p) => <PieceCard piece={p} />)}
    </div>

    <div class="center" style="margin:48px 0 10px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a class="btn btn-ghost" href={url('/equipe')}>Toute la rédaction</a>
      <a class="btn" href={url('/critiques')}>Toutes les critiques</a>
    </div>
  </div>
</Base>

<style>
  .author-head { display: flex; gap: 22px; align-items: flex-start; margin: 6px 0 8px; padding-bottom: 26px; border-bottom: 3px solid var(--acc); }
  .author-head .role { font-family: var(--sans); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--acc); margin: 0 0 2px; }
  .author-id h1 { margin: 0 0 10px; font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .author-bio { font-family: var(--serif); font-size: 1.1rem; color: var(--ink-2); line-height: 1.5; margin: 0 0 14px; max-width: 54ch; }
  .author-stats { display: flex; gap: 24px; margin: 0; }
  .author-stats strong { font-family: var(--serif); color: var(--red); font-size: 1.2rem; }
  .author-stats span { font-family: var(--sans); font-size: 0.74rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.04em; }
  @media (max-width: 560px) {
    .author-head { flex-direction: column; align-items: center; text-align: center; }
    .author-stats { justify-content: center; }
  }
</style>
