---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const abs = (p: string) => new URL(url(p), Astro.site).href;

const termes = [
  { t: 'Côté cour, côté jardin', d: "Les deux côtés de la scène vus depuis la salle : le jardin à gauche, la cour à droite. Un moyen mnémotechnique : « Jésus-Christ », Jardin à gauche, Cour à droite." },
  { t: 'La générale', d: "L'ultime répétition, en conditions réelles et souvent devant un public d'invités, juste avant la première représentation." },
  { t: 'La première', d: "La toute première représentation publique d'un spectacle. Moment de vérité pour la troupe." },
  { t: 'Le filage', d: "Une répétition où l'on joue la pièce en entier, sans s'arrêter, pour en éprouver le rythme d'ensemble." },
  { t: "L'italienne", d: "Une répétition du texte seul, dit rapidement et sans jeu, pour vérifier que tout le monde connaît ses répliques." },
  { t: 'Les trois coups', d: "Les trois coups frappés sur le plateau (avec le brigadier) pour annoncer le début du spectacle et faire taire la salle." },
  { t: 'Le lever de rideau', d: "Le moment où le spectacle commence. Par extension, on parle du « nombre de levers de rideau » pour compter les représentations." },
  { t: 'Le rappel', d: "Les applaudissements qui font revenir les comédiens saluer sur scène, une ou plusieurs fois, à la fin du spectacle." },
  { t: 'La servante', d: "La petite lampe qu'on laisse allumée sur un plateau vide, pour ne jamais le plonger complètement dans le noir. Une tradition, et une sécurité." },
  { t: 'Le strapontin', d: "Le siège rabattable, souvent placé en bout de rangée, qu'on déplie quand la salle est comble." },
  { t: 'Le praticable', d: "Un élément de décor solide sur lequel les comédiens peuvent réellement monter et jouer, par opposition à un décor peint." },
  { t: 'Le quatrième mur', d: "Le mur imaginaire entre la scène et la salle. Le « briser », c'est s'adresser directement au public." },
  { t: 'La jauge', d: "Le nombre de places qu'une salle peut accueillir. La Cour d'honneur du Palais des Papes affiche par exemple une jauge d'environ 2 000 spectateurs." },
  { t: 'La mise en scène', d: "Le travail du metteur ou de la metteuse en scène : diriger les comédiens, organiser l'espace, le rythme et le sens du spectacle." },
  { t: 'La scénographie', d: "La conception de l'espace scénique : décor, volumes, lumière, tout ce qui compose l'image de plateau." },
  { t: 'La distribution', d: "L'ensemble des comédiens qui jouent dans un spectacle, et la répartition des rôles entre eux." },
  { t: 'Le seul-en-scène', d: "Un spectacle porté par un seul interprète, aussi appelé solo ou monologue. Une forme reine du OFF d'Avignon." },
  { t: 'Le tréteau', d: "Le théâtre de tréteaux : un théâtre ambulant et populaire, joué sur une estrade sommaire, tout en énergie et en adresse au public." },
  { t: 'Le tractage', d: "La distribution de tracts dans la rue par les compagnies, souvent costumées, pour attirer le public vers leur spectacle. Une institution du OFF." },
  { t: 'La carte OFF', d: "L'abonnement du Festival OFF d'Avignon, créé en 1982, qui donne droit à une réduction sur la plupart des spectacles." },
  { t: 'Le noir', d: "L'extinction totale des lumières, souvent utilisée pour marquer un changement de scène ou la fin d'un spectacle." },
  { t: 'Les coulisses', d: "L'espace caché de part et d'autre et derrière la scène, d'où entrent et sortent les comédiens." },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'Lexique du théâtre',
    url: abs('/guides/lexique-du-theatre'),
    hasDefinedTerm: termes.map((x) => ({ '@type': 'DefinedTerm', name: x.t, description: x.d })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: abs('/guides') },
      { '@type': 'ListItem', position: 3, name: "Lexique du théâtre", item: abs('/guides/lexique-du-theatre') },
    ],
  },
];
---
<Base
  title="Lexique du théâtre : les mots à connaître — La Claque"
  description="Côté cour et côté jardin, la générale, les trois coups, la servante, le quatrième mur : le vocabulaire du théâtre et des plateaux, expliqué simplement."
  active="guides"
  jsonld={jsonld}
>
  <article class="wrap-narrow guide">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › <a href={url('/guides')}>Guides</a> › Lexique du théâtre</p>
    <div class="guide-head">
      <p class="kicker">Vocabulaire</p>
      <h1>Lexique du théâtre : les mots à connaître</h1>
      <p class="stand">Le théâtre a sa langue, faite de traditions et de superstitions. Voici les mots qu'on entend le plus souvent, expliqués sans jargon. Vous y reconnaîtrez d'ailleurs les noms de scène de notre <a href={url('/equipe')}>rédaction</a>.</p>
    </div>

    <div class="prose">
      <dl class="lexique">
        {termes.map((x) => (
          <>
            <dt>{x.t}</dt>
            <dd>{x.d}</dd>
          </>
        ))}
      </dl>
    </div>

    <div class="related">
      <h2>À lire aussi</h2>
      <a href={url('/guides/festival-in-et-off-avignon')}>IN et OFF : quelle différence ?</a>
      <a href={url('/guides/off-avignon-mode-demploi')}>Le OFF, mode d'emploi</a>
      <a href={url('/equipe')}>Nos huit plumes</a>
    </div>
  </article>
</Base>
