---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { guidesForSection } from '../../data/guides';

const abs = (p: string) => new URL(url(p), Astro.site).href;

const spectateur = guidesForSection('spectateur');
const metier = guidesForSection('metier');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Guides du théâtre et du Festival d’Avignon',
    url: abs('/guides'),
    description: "Nos guides pour comprendre le théâtre et le Festival d'Avignon, côté spectateur comme côté métier.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: abs('/guides') },
    ],
  },
];
---
<Base
  title="Guides du théâtre et du Festival d'Avignon | La Claque"
  description="Nos guides pour comprendre le théâtre et le Festival d'Avignon : différence IN et OFF, chiffres, mode d'emploi, lexique, et côté métier l'intermittence, la production et la création de compagnie."
  active="guides"
  jsonld={jsonld}
>
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › Guides</p>
    <div class="guide-head">
      <p class="kicker">Guides</p>
      <h1>Comprendre le théâtre et le Festival d'Avignon</h1>
      <p class="stand">On ne fait pas que noter des spectacles : on partage aussi ce qu'on a appris à force d'arpenter les salles, côté fauteuil comme côté coulisses.</p>
    </div>
  </div>

  <div class="wrap">
    <div class="rubric">
      <h2>Côté spectateur</h2>
      <span class="line"></span>
      <span class="note">Profiter du festival</span>
    </div>
    <div class="guide-cards">
      {spectateur.map((g) => (
        <a class="guide-card" href={url(`/guides/${g.slug}`)}>
          <span class="k">{g.k}</span>
          <h3>{g.titre}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>

    <div class="rubric">
      <h2>Côté métier</h2>
      <span class="line"></span>
      <span class="note">Pour les artistes et les compagnies</span>
    </div>
    <div class="guide-cards">
      {metier.map((g) => (
        <a class="guide-card" href={url(`/guides/${g.slug}`)}>
          <span class="k">{g.k}</span>
          <h3>{g.titre}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
