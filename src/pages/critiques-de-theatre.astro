---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import PieceCard from '../components/PieceCard.astro';
import Avatar from '../components/Avatar.astro';
import { PIECES } from '../data/pieces';
import { CRITICS, CRITIC_ORDER, criticSlug } from '../data/critics';
import { CATEGORIES, categorieFor } from '../lib/categories';
import { consensusScore, verdictFor, nbVus } from '../lib/rating';
import { GUIDES } from '../data/guides';
import { url } from '../lib/url';

const abs = (p) => new URL(url(p), Astro.site).href;

const total = PIECES.length;
const noteMoyenne = (PIECES.reduce((s, p) => s + p.noteMoy, 0) / total);
const grossesClaques = PIECES.filter((p) => p.noteMoy >= 8).length;
const totalYeux = PIECES.reduce((s, p) => s + nbVus(p), 0);
const plumes = CRITIC_ORDER.map((k) => CRITICS[k]).filter((c) => PIECES.some((p) => p.signataire === c.key));

const cats = CATEGORIES
  .map((cat) => ({ cat, count: PIECES.filter((p) => categorieFor(p.style) === cat).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const top = [...PIECES].sort((a, b) => consensusScore(b) - consensusScore(a)).slice(0, 6);

const fmt1 = (n) => n.toFixed(1).replace('.', ',');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Critiques de théâtre',
    headline: 'Critiques de théâtre : le meilleur du OFF d’Avignon et de la scène',
    url: abs('/critiques-de-theatre'),
    description: `${total} critiques de théâtre signées par une rédaction de comédien·nes, à plusieurs paires d'yeux. Étoiles, coups de cœur, palmarès et guides.`,
    inLanguage: 'fr',
    isPartOf: { '@type': 'WebSite', name: 'La Claque', url: abs('/') },
    about: { '@type': 'Thing', name: 'Théâtre' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Nos meilleures critiques de théâtre',
    itemListElement: top.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/critiques/${p.slug}`), name: p.titre })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Critiques de théâtre', item: abs('/critiques-de-theatre') },
    ],
  },
];
---
<Base
  title="Critiques de théâtre — La Claque, le OFF d'Avignon à plusieurs paires d'yeux"
  description={`Le meilleur des critiques de théâtre : ${total} spectacles vus, notés et racontés par une rédaction de comédien·nes. Étoiles, grosses claques, palmarès et guides du OFF d'Avignon.`}
  active="critiques"
  jsonld={jsonld}
>
  <!-- OUVERTURE SPECTACULAIRE -->
  <section class="pillar-hero">
    <div class="ph-inner">
      <p class="ph-kicker"><Mark size={22} /> La Claque · Critiques de théâtre</p>
      <h1>On voit tout.<br />On note fort.<br /><em>On vous raconte.</em></h1>
      <p class="ph-stand">Une bande de comédien·nes qui court les salles à plusieurs paires d'yeux et ne boude jamais son plaisir. Le théâtre passé au crible, sans jargon, sans langue de bois, avec la générosité de ceux qui savent ce que ça coûte de monter sur scène.</p>
      <div class="ph-cta">
        <a class="btn-xl" href={url('/critiques')}>Voir les {total} critiques</a>
        <a class="btn-xl ghost" href={url('/palmares')}>Le palmarès</a>
      </div>
    </div>
  </section>

  <!-- GRANDS CHIFFRES -->
  <section class="bigstats">
    <div class="bs-item"><span class="n">{total}</span><span class="l">spectacles<br />critiqués</span></div>
    <div class="bs-item"><span class="n">{grossesClaques}</span><span class="l">grosses<br />claques</span></div>
    <div class="bs-item"><span class="n">{plumes.length}</span><span class="l">plumes<br />signataires</span></div>
    <div class="bs-item"><span class="n">{totalYeux}</span><span class="l">paires<br />d'yeux</span></div>
    <div class="bs-item accent"><span class="n">{fmt1(noteMoyenne)}</span><span class="l">de moyenne<br />sur 10</span></div>
  </section>

  <div class="wrap">
    <!-- PAR CATEGORIE -->
    <div class="rubric big"><h2>Par genre</h2><span class="line"></span><span class="note">Trouvez votre soirée</span></div>
    <div class="cat-grid">
      {cats.map(({ cat, count }) => (
        <a class="cat-tile" href={url(`/critiques?cat=${encodeURIComponent(cat)}`)}>
          <span class="ct-count">{count}</span>
          <span class="ct-name">{cat}</span>
          <span class="ct-go">Voir →</span>
        </a>
      ))}
    </div>
  </div>

  <!-- LES INCONTOURNABLES (bande sombre, spectaculaire) -->
  <section class="dark-band">
    <div class="wrap">
      <div class="rubric big invert"><h2>Les incontournables</h2><span class="line"></span><span class="note">Le haut du panier</span></div>
      <div class="cards">
        {top.map((p) => <PieceCard piece={p} />)}
      </div>
    </div>
  </section>

  <div class="wrap">
    <!-- LA REDACTION -->
    <div class="rubric big"><h2>La rédaction</h2><span class="line"></span><span class="note">Des plumes qu'on suit</span></div>
    <div class="plume-row">
      {plumes.map((c) => (
        <a class="plume-chip" href={url(`/equipe/${criticSlug(c)}`)} style={`--acc:${c.couleur}`}>
          <Avatar critic={c.key} size={52} />
          <span class="pc-name">{c.plume}</span>
          <span class="pc-role">{c.role}</span>
        </a>
      ))}
    </div>

    <!-- GUIDES -->
    <div class="rubric big"><h2>Pour aller plus loin</h2><span class="line"></span><span class="note">Nos guides du théâtre</span></div>
    <div class="guide-links">
      {GUIDES.slice(0, 6).map((g) => (
        <a href={url(`/guides/${g.slug}`)}><span class="gl-k">{g.k}</span><span class="gl-t">{g.titre}</span></a>
      ))}
    </div>
    <p class="center" style="margin:26px 0 60px"><a class="btn-xl" href={url('/jouer')}>Et si vous meniez une troupe ? Jouez « Un mois au OFF » →</a></p>
  </div>
</Base>

<style>
  /* OUVERTURE */
  .pillar-hero { background: var(--ink); color: var(--paper); }
  .ph-inner { max-width: var(--wrap); margin: 0 auto; padding: clamp(48px, 8vw, 96px) 24px clamp(40px, 6vw, 80px); }
  .ph-kicker { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: #f0c74a; margin: 0 0 20px; }
  .pillar-hero h1 { font-family: var(--display); font-weight: 900; font-size: clamp(2.8rem, 9vw, 7rem); line-height: 0.96; letter-spacing: -0.03em; margin: 0 0 26px; color: #fff; }
  .pillar-hero h1 em { color: var(--red); font-style: italic; }
  .ph-stand { font-family: var(--serif); font-size: clamp(1.1rem, 2vw, 1.5rem); line-height: 1.45; color: rgba(255,255,255,0.82); max-width: 60ch; margin: 0 0 32px; }
  .ph-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-xl { display: inline-block; font-family: var(--sans); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; background: var(--red); color: #fff; padding: 17px 30px; border-radius: 2px; text-decoration: none; transition: transform 0.12s ease, filter 0.12s ease; }
  .btn-xl:hover { transform: translateY(-2px); filter: brightness(1.08); }
  .btn-xl.ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.55); }
  .btn-xl.ghost:hover { box-shadow: inset 0 0 0 2px #fff; }

  /* GRANDS CHIFFRES */
  .bigstats { max-width: var(--wrap); margin: 0 auto; padding: clamp(34px,5vw,60px) 24px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; border-bottom: 3px double var(--ink); }
  .bs-item { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .bs-item .n { font-family: var(--display); font-weight: 900; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 0.9; letter-spacing: -0.03em; color: var(--ink); }
  .bs-item.accent .n { color: var(--red); }
  .bs-item .l { font-family: var(--sans); font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); line-height: 1.3; }

  /* RUBRIQUES AMPLIFIÉES */
  .rubric.big { margin: 60px 0 24px; }
  .rubric.big h2 { font-family: var(--display); font-weight: 900; font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -0.02em; }
  .rubric.big .line { height: 3px; background: var(--ink); }
  .rubric.big.invert h2 { color: #fff; }
  .rubric.big.invert .line { background: rgba(255,255,255,0.5); }
  .rubric.big.invert .note { color: rgba(255,255,255,0.6); }

  /* CATEGORIES */
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .cat-tile { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 150px; padding: 20px; text-decoration: none; background: var(--card); border: 1px solid var(--rule-2); overflow: hidden; transition: transform 0.12s ease, border-color 0.12s ease; }
  .cat-tile:hover { transform: translateY(-3px); border-color: var(--ink); }
  .cat-tile .ct-count { position: absolute; top: -10px; right: 6px; font-family: var(--display); font-weight: 900; font-size: 5.5rem; line-height: 1; color: var(--rule-2); z-index: 0; }
  .cat-tile:hover .ct-count { color: var(--red); opacity: 0.22; }
  .cat-tile .ct-name { position: relative; z-index: 1; font-family: var(--display); font-weight: 700; font-size: 1.5rem; color: var(--ink); }
  .cat-tile .ct-go { position: relative; z-index: 1; font-family: var(--sans); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--red); margin-top: 6px; }

  /* BANDE SOMBRE */
  .dark-band { background: var(--ink); margin: 60px 0; padding: 10px 0 54px; }
  .dark-band .rubric.big { margin-top: 46px; }

  /* PLUMES */
  .plume-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .plume-chip { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 20px 12px; text-decoration: none; background: var(--card); border: 1px solid var(--rule-2); border-bottom: 3px solid var(--acc); transition: transform 0.12s ease; }
  .plume-chip:hover { transform: translateY(-3px); }
  .plume-chip .pc-name { font-family: var(--display); font-weight: 700; font-size: 1.05rem; color: var(--ink); margin-top: 4px; }
  .plume-chip .pc-role { font-family: var(--sans); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--acc); }

  /* GUIDES */
  .guide-links { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2px; }
  .guide-links a { display: block; padding: 16px 18px; background: var(--card); border: 1px solid var(--rule-2); text-decoration: none; transition: border-color 0.12s ease, background 0.12s ease; }
  .guide-links a:hover { border-color: var(--ink); background: var(--paper); }
  .guide-links .gl-k { display: block; font-family: var(--sans); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--red); margin-bottom: 4px; }
  .guide-links .gl-t { display: block; font-family: var(--serif); font-size: 1.02rem; color: var(--ink); line-height: 1.25; }

  @media (max-width: 720px) {
    .bigstats { grid-template-columns: repeat(2, 1fr); gap: 24px 8px; }
    .bs-item.accent { grid-column: span 2; }
  }
</style>
