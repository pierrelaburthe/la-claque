---
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import { PIECES } from '../data/pieces';
import { AUTHOR } from '../data/author';
import type { CriticKey } from '../data/critics';
import { CATEGORIES, categorieFor } from '../lib/categories';
import { consensusScore, verdictFor, nbVus } from '../lib/rating';
import { GUIDES } from '../data/guides';
import { url } from '../lib/url';

const abs = (p) => new URL(url(p), Astro.site).href;

const claqueurs = new Set(PIECES.flatMap((p) => Object.keys(p.notes) as CriticKey[])).size;
const total = PIECES.length;
const noteMoyenne = (PIECES.reduce((s, p) => s + p.noteMoy, 0) / total);
const grossesClaques = PIECES.filter((p) => p.noteMoy >= 8).length;
const totalYeux = PIECES.reduce((s, p) => s + nbVus(p), 0);

const cats = CATEGORIES
  .map((cat) => ({ cat, count: PIECES.filter((p) => categorieFor(p.style) === cat).length }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const top = [...PIECES].sort((a, b) => consensusScore(b) - consensusScore(a)).slice(0, 6);

const fmt1 = (n) => n.toFixed(1).replace('.', ',');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Critiques de théâtre',
    headline: 'Critiques de théâtre : le meilleur du OFF d’Avignon et de la scène',
    url: abs('/critiques-de-theatre'),
    description: `${total} critiques de théâtre signées ${AUTHOR.nom}, écrites à partir des spectacles vus par une bande de comédien·nes. Étoiles, coups de cœur, palmarès et guides.`,
    inLanguage: 'fr',
    isPartOf: { '@type': 'WebSite', name: 'La Claque', url: abs('/') },
    about: { '@type': 'Thing', name: 'Théâtre' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Nos meilleures critiques de théâtre',
    itemListElement: top.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/critiques/${p.slug}`), name: p.titre })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Critiques de théâtre', item: abs('/critiques-de-theatre') },
    ],
  },
];
---
<Base
  title="Critiques de théâtre : avis et notes du OFF d'Avignon 2026 | La Claque"
  description={`Le meilleur des critiques de théâtre : ${total} spectacles vus, notés et racontés par une rédaction de comédien·nes. Étoiles, grosses claques, palmarès et guides du OFF d'Avignon.`}
  active="critiques"
  jsonld={jsonld}
>
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href={url('/')}>Accueil</a> › Critiques de théâtre</p>
    <div class="guide-head">
      <p class="kicker">Le repère des critiques de théâtre</p>
      <h1>Critiques de théâtre</h1>
      <p class="stand">Une bande de comédien·nes qui court les salles ensemble et ne boude jamais son plaisir. Ils voient, j'écris. Le théâtre passé au crible, sans jargon et sans langue de bois.</p>
    </div>
    <p class="pillar-stats">
      <span><strong>{total}</strong> spectacles critiqués</span>
      <span><strong>{grossesClaques}</strong> grosses claques</span>
      <span><strong>{claqueurs}</strong> claqueurs</span>
      <span><strong>{fmt1(noteMoyenne)}</strong> de moyenne sur 10</span>
    </p>
  </div>

  <div class="wrap">
    <div class="rubric"><h2>Par genre</h2><span class="line"></span><span class="note">Trouvez votre soirée</span></div>
    <div class="guide-cards">
      {cats.map(({ cat, count }) => (
        <a class="guide-card" href={url(`/critiques?cat=${encodeURIComponent(cat)}`)}>
          <span class="k">{count} spectacle{count > 1 ? 's' : ''}</span>
          <h3>{cat}</h3>
        </a>
      ))}
    </div>

    <div class="rubric"><h2>Les incontournables</h2><span class="line"></span><span class="note">Le haut du panier</span></div>
    <div class="cards">
      {top.map((p) => <PieceCard piece={p} />)}
    </div>

    <div class="rubric"><h2>Qui écrit</h2><span class="line"></span><span class="note">Un rédacteur, une bande</span></div>
    <a class="author-strip" href={url('/equipe#auteur')}>
      <span class="as-name">{AUTHOR.nom}</span>
      <span class="as-role">{AUTHOR.ligne}</span>
      <span class="as-txt">Je signe toutes les critiques du site. Elles s'appuient sur les spectacles vus par une bande d'une dizaine de comédiennes et comédiens, qui notent chacun de leur côté.</span>
      <span class="as-more">Comment on travaille →</span>
    </a>

    <div class="rubric"><h2>Pour aller plus loin</h2><span class="line"></span><span class="note">Nos guides du théâtre</span></div>
    <div class="guide-links">
      {GUIDES.slice(0, 6).map((g) => (
        <a href={url(`/guides/${g.slug}`)}><span class="gl-k">{g.k}</span><span class="gl-t">{g.titre}</span></a>
      ))}
    </div>

    <div class="center" style="margin:44px 0 60px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a class="btn" href={url('/critiques')}>Voir les {total} critiques</a>
      <a class="btn btn-ghost" href={url('/palmares')}>Le palmarès</a>
    </div>
  </div>
</Base>

<style>
  .pillar-stats { display: flex; flex-wrap: wrap; gap: 8px 30px; margin: 0 0 10px; font-family: var(--sans); font-size: 0.88rem; color: var(--ink-3); }
  .pillar-stats span { white-space: nowrap; }
  .pillar-stats strong { font-family: var(--serif); color: var(--red); font-size: 1.05rem; }
  .plume-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .plume-chip { display: flex; align-items: center; gap: 12px; padding: 12px 14px; text-decoration: none; background: var(--card); border: 1px solid var(--rule-2); transition: border-color 0.12s ease; }
  .plume-chip:hover { border-color: var(--ink); }
  .plume-chip .pc-txt { display: flex; flex-direction: column; }
  .plume-chip .pc-name { font-family: var(--serif); font-weight: 700; font-size: 1.02rem; color: var(--ink); }
  .plume-chip .pc-role { font-family: var(--sans); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .guide-links { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2px; }
  .guide-links a { display: block; padding: 14px 16px; background: var(--card); border: 1px solid var(--rule-2); text-decoration: none; transition: border-color 0.12s ease, background 0.12s ease; }
  .guide-links a:hover { border-color: var(--ink); background: var(--paper); }
  .guide-links .gl-k { display: block; font-family: var(--sans); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--red); margin-bottom: 3px; }
  .guide-links .gl-t { display: block; font-family: var(--serif); font-size: 1rem; color: var(--ink); line-height: 1.25; }

  .author-strip { display: block; text-decoration: none; color: inherit; background: var(--card); border: 1px solid var(--rule-2); border-left: 4px solid var(--red); padding: 20px 24px; transition: border-color 0.12s ease; }
  .author-strip:hover { border-left-color: var(--ink); }
  .author-strip .as-name { display: block; font-family: var(--display); font-weight: 900; font-size: 1.35rem; }
  .author-strip .as-role { display: block; font-family: var(--sans); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--red); margin-top: 3px; }
  .author-strip .as-txt { display: block; color: var(--ink-2); margin-top: 10px; max-width: 62ch; }
  .author-strip .as-more { display: block; font-family: var(--sans); font-size: 0.78rem; font-weight: 700; color: var(--red); margin-top: 12px; }
</style>
