---
import '../styles/global.css';
import { url } from '../lib/url';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  jsonld?: unknown[];
  image?: string;
}
const { title, description = "Critiques de théâtre par une bande d'ami·es qui applaudit fort. Étoiles, coups de cœur et découvertes, à Avignon et toute l'année.", active, jsonld = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = new URL(url('/'), Astro.site).href;
// Carte de partage 1200×630 : celle fournie, sinon la carte par défaut.
const ogImage = image || new URL(url('/og/default.png'), Astro.site).href;

// Données structurées présentes sur toutes les pages (identité du site).
const baseJsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'La Claque',
    url: siteRoot,
    description: 'Média de critique théâtrale tenu par une bande d’ami·es. Critiques de spectacles, étoiles, coups de cœur et guides sur le théâtre et le Festival d’Avignon.',
    sameAs: ['https://github.com/pierrelaburthe/la-claque'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'La Claque',
    url: siteRoot,
    inLanguage: 'fr',
  },
];
const allJsonld = [...baseJsonld, ...jsonld];
const nav = [
  { href: url('/'), label: 'La Une', key: 'accueil' },
  { href: url('/critiques'), label: 'Critiques', key: 'critiques' },
  { href: url('/palmares'), label: 'Palmarès', key: 'palmares' },
  { href: url('/guides'), label: 'Guides', key: 'guides' },
  { href: url('/equipe'), label: 'La rédaction', key: 'equipe' },
  { href: url('/a-propos'), label: 'À propos', key: 'apropos' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="La Claque" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="La Claque — critiques de théâtre" href={url('/rss.xml')} />
    <link rel="stylesheet" href={url('/fonts/fonts.css')} />
    {allJsonld.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="brandbar"></div>
    <header class="masthead">
      <div class="top">
        <a class="logo" href={url('/')}>
          <Mark size={32} />
          <span class="wm">
            <span class="word">La <b>Claque</b></span>
            <small>Critiques de théâtre, à plusieurs paires d'yeux</small>
          </span>
        </a>
      </div>
      <nav>
        <div class="inner">
          {nav.map((n) => (
            <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot-site">
      <div class="inner">
        <div>
          <div class="logo" style="display:flex; align-items:center; gap:10px;"><Mark size={26} /> <span>La <b>Claque</b></span></div>
          <p style="margin-top:10px">Une dizaine de comédien·nes qui vont au théâtre et en parlent à plusieurs paires d'yeux, sans jamais bouder leur plaisir. On applaudit pour de vrai, à Avignon et toute l'année.</p>
        </div>
        <div>
          <h4>Le journal</h4>
          <a href={url('/critiques-de-theatre')}>Critiques de théâtre</a>
          <a href={url('/critiques')}>Toutes les critiques</a>
          <a href={url('/palmares')}>Palmarès</a>
          <a href={url('/guides')}>Guides</a>
          <a href={url('/jouer')}>Le jeu : un mois au OFF</a>
          <a href={url('/equipe')}>La rédaction</a>
          <a href={url('/a-propos')}>À propos</a>
          <a href={url('/rss.xml')}>Flux RSS</a>
        </div>
        <div>
          <h4>En ce moment</h4>
          <span class="metaline" style="color:var(--ink-3)">Dossier Avignon OFF 2026</span>
          <a href="https://www.festivaloffavignon.com" rel="noopener">Festival OFF d'Avignon</a>
        </div>
      </div>
    </footer>
  </body>
</html>
