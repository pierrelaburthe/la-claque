---
// Emblème de marque : un éclat d'applaudissement (la « claque »).
interface Props { size?: number; color?: string; }
const { size = 28, color = 'var(--red)' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" role="img" aria-label="La Claque" class="mark">
  <g stroke={color} stroke-width="3.2" stroke-linecap="round" fill="none">
    <path d="M20 12 L20 4" />
    <path d="M20 28 L20 36" />
    <path d="M12 20 L4 20" />
    <path d="M28 20 L36 20" />
    <path d="M14.5 14.5 L8.7 8.7" />
    <path d="M25.5 14.5 L31.3 8.7" />
    <path d="M14.5 25.5 L8.7 31.3" />
    <path d="M25.5 25.5 L31.3 31.3" />
  </g>
  <circle cx="20" cy="20" r="4.2" fill={color} />
</svg>
