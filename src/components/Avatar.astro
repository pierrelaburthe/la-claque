---
// Avatars illustrés des critiques : une icône de théâtre par nom de scène.
// 100% SVG inline (aucune image externe, aucune photo de personne réelle).
import { CRITICS, type CriticKey } from '../data/critics';

interface Props {
  critic: CriticKey;
  size?: number;
  ring?: boolean;
}
const { critic, size = 64, ring = true } = Astro.props;
const c = CRITICS[critic];
const ink = '#fbf4e6';
const s = size;
---
<svg
  width={s}
  height={s}
  viewBox="0 0 64 64"
  role="img"
  aria-label={`Avatar de ${c.plume}`}
  class="avatar"
  style={`--acc:${c.couleur}`}
>
  <defs>
    <radialGradient id={`g-${critic}`} cx="35%" cy="28%" r="80%">
      <stop offset="0%" stop-color={c.couleur} stop-opacity="1" />
      <stop offset="100%" stop-color={c.couleur} stop-opacity="0.82" />
    </radialGradient>
  </defs>
  <circle cx="32" cy="32" r="31" fill={`url(#g-${critic})`} />
  {ring && <circle cx="32" cy="32" r="30" fill="none" stroke={ink} stroke-opacity="0.35" stroke-width="1" />}
  <g fill="none" stroke={ink} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    {critic === 'lucie' && (
      // La servante : lampe fantôme laissée allumée sur le plateau.
      <g>
        <circle cx="32" cy="22" r="6.5" fill={ink} stroke="none" />
        <path d="M25 16 L21 12 M39 16 L43 12 M32 13 L32 9 M24 24 L20 26 M40 24 L44 26" stroke-width="1.8" />
        <path d="M32 28.5 L32 44" />
        <path d="M20 50 L32 44 L44 50" />
        <path d="M32 44 L32 50" />
      </g>
    )}
    {critic === 'pierre' && (
      // Le strapontin : siège rabattable.
      <g>
        <rect x="21" y="15" width="22" height="17" rx="5" />
        <path d="M18 30 L18 46 M46 30 L46 46" />
        <path d="M18 46 L46 46 L43 38 L21 38 Z" />
      </g>
    )}
    {critic === 'julie' && (
      // Côté cour / côté jardin : deux rideaux écartés.
      <g>
        <path d="M12 15 L52 15" />
        <path d="M18 15 C15 26 16 36 12 47 C19 45 22 40 22 15" />
        <path d="M46 15 C49 26 48 36 52 47 C45 45 42 40 42 15" />
        <path d="M32 17 L32 47" stroke-dasharray="2 4" stroke-width="1.8" />
      </g>
    )}
    {critic === 'alexandre' && (
      // L'avant-scène : cadre de scène et rampe de lumières.
      <g>
        <path d="M14 47 L14 23 C14 16 18 14 24 14 L40 14 C46 14 50 16 50 23 L50 47" />
        <path d="M12 47 L52 47" />
        <circle cx="20" cy="47" r="1.6" fill={ink} stroke="none" />
        <circle cx="28" cy="47" r="1.6" fill={ink} stroke="none" />
        <circle cx="36" cy="47" r="1.6" fill={ink} stroke="none" />
        <circle cx="44" cy="47" r="1.6" fill={ink} stroke="none" />
      </g>
    )}
    {critic === 'etienne' && (
      // Le praticable : le cube sur lequel on monte pour de vrai.
      <g>
        <path d="M32 15 L47 24 L32 33 L17 24 Z" />
        <path d="M17 24 L17 40 L32 49 L32 33 Z" />
        <path d="M47 24 L47 40 L32 49 L32 33 Z" />
      </g>
    )}
    {critic === 'henry' && (
      // Les feux de la rampe.
      <g>
        <path d="M14 45 L50 45" />
        <path d="M20 45 A4 4 0 0 1 28 45 M28 45 A4 4 0 0 1 36 45 M36 45 A4 4 0 0 1 44 45" />
        <path d="M22 36 L20 30 M32 34 L32 27 M42 36 L44 30" stroke-width="1.9" />
      </g>
    )}
    {critic === 'cedric' && (
      // Les trois coups : le brigadier qui frappe le plateau.
      <g>
        <circle cx="32" cy="12" r="2.6" fill={ink} stroke="none" />
        <path d="M32 15 L32 44" />
        <path d="M18 46 L46 46" />
        <path d="M40 20 A9 9 0 0 1 40 36 M44 17 A14 14 0 0 1 44 39" stroke-width="1.8" />
      </g>
    )}
    {critic === 'sana' && (
      // La générale : le clap de la dernière répétition.
      <g>
        <rect x="16" y="29" width="32" height="18" rx="2.5" />
        <path d="M16 30 L47 24 L49 31 L18 37 Z" fill={ink} stroke="none" />
        <path d="M23 27 L26 34 M31 25 L34 32 M39 23 L42 30" stroke={c.couleur} stroke-width="1.8" />
        <path d="M22 40 L42 40" stroke-width="1.7" />
      </g>
    )}
  </g>
</svg>

<style>
  .avatar {
    display: block;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgba(26, 20, 15, 0.18);
  }
</style>
