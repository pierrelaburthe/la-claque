---
import { Image } from 'astro:assets';
import type { Piece } from '../data/pieces';
import { verdictFor, nbVus, estPlebiscite, seenLabel } from '../lib/rating';
import { categorieFor } from '../lib/categories';
import { affiche } from '../lib/images';
import Stars from './Stars.astro';
import { url } from '../lib/url';

interface Props { piece: Piece; }
const { piece } = Astro.props;
// La vignette est recadrée en 3/4 par le CSS : la grille descend à 258 px de
// colonne et monte rarement au-dessus de 340. On sert 300 px, doublés pour les
// écrans à forte densité.
const img = affiche(piece.image);
const seen = nbVus(piece);
const pleb = estPlebiscite(piece);
const chef = piece.noteMoy >= 8;
const categorie = categorieFor(piece.style);
// La signature est la même partout depuis qu'un seul rédacteur signe : sur une
// grille de cartes, elle n'apporte rien. On affiche la salle à la place, qui
// aide vraiment à choisir, et on la garde dans l'index de recherche.
const searchText = [piece.titre, piece.titreExact, piece.style, categorie, piece.salle, piece.chapo]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---
<a class="pcard" href={url(`/critiques/${piece.slug}`)} data-cat={categorie} data-text={searchText}>
  <div class="frame">
    {img
      ? <Image src={img} alt={`Affiche de ${piece.titre}`} width={300} densities={[1, 2]} loading="lazy" decoding="async" format="webp" />
      : <div class="fallback">{piece.titre}</div>}
    {chef
      ? <span class="corner">Grosse claque</span>
      : pleb
        ? <span class="corner">Plébiscite</span>
        : null}
  </div>
  <span class="kicker">{piece.style}</span>
  <h3>{piece.titre}</h3>
  <div class="byline">
    {piece.reprise && <span class="a-laffiche">À l'affiche</span>}
    {/* Quand le spectacle se rejoue, la salle utile est celle de la reprise,
        pas celle où on l'a vu il y a des mois. */}
    {piece.reprise ? piece.reprise.lieu : piece.salle}
  </div>
  <div class="foot">
    <Stars note={piece.noteMoy} />
    <span class="verdict">{verdictFor(piece.noteMoy)}</span>
    <span class="seen">{seenLabel(seen)}</span>
  </div>
</a>

<style>
  /* L'affiche manquante retombe sur le rouge de rideau du site. */
  .pcard .frame .fallback { background: var(--red); }
  /* Signale les spectacles dont on a vérifié qu'ils se jouent encore. */
  .pcard .byline { align-items: flex-start; }
  .a-laffiche {
    display: inline-block; background: var(--red); color: #fff; border-radius: 2px;
    font-size: 0.58rem; font-weight: 800; letter-spacing: 0.08em; padding: 2px 6px;
    text-transform: uppercase; flex: none;
  }
</style>
